# The channel from Chromium to HarmonyOS services that exist only in ArkTS.
# The app's N-API layer installs the dispatcher; the features that use it
# (TTS, notifications, shape detection, WebAuthn, orientation) depend on this.
static_library("ohos_system_service") {
  sources = [
    "system_service_ohos.cc",
    "system_service_ohos.h",
  ]
  deps = [ "//base" ]
}
