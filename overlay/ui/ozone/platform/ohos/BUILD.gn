import("//gpu/vulkan/features.gni")

visibility = [ "//ui/ozone/*" ]

source_set("event_source") {
  visibility += [ "//ohos_nweb/src/aura_shell:*" ]

  sources = [
    "ohos_event_source.cc",
    "ohos_event_source.h",
  ]

  deps = [
    "//base",
    "//ui/events",
    "//ui/events/platform",
  ]
}

source_set("native_window_registry") {
  visibility += [
    "//ohos_nweb/src/aura_shell:*",
    "//services/device/wake_lock/power_save_blocker:*",

    # Losing the GPU context is noticed here, and the shell has to hear
    # about it. Widened for that one call rather than for the header.
    "//gpu/ipc/service:*",
  ]

  sources = [
    "ohos_gpu_child_channel.cc",
    "ohos_gpu_child_channel.h",
    "ohos_native_window_registry.cc",
    "ohos_native_window_registry.h",
  ]

  # The GPU process's own native child and the channel that carries its
  # windows: ohos_gpu_child_channel.h.
  libs = [
    "child_process",
    "ipc_capi",
    "native_window",
  ]

  deps = [
    "//base",
    "//third_party/vulkan-headers/src:vulkan_headers",
    "//ui/base",
    "//ui/gfx/geometry",
  ]
}

source_set("ohos") {
  visibility += [ "//ohos_nweb/src/aura_shell:*" ]

  sources = [
    "ohos_clipboard.cc",
    "ohos_clipboard.h",
    "ohos_input_method.cc",
    "ohos_input_method.h",
    "ohos_native_window_adapter.cc",
    "ohos_native_window_adapter.h",
    "ohos_platform_window.cc",
    "ohos_platform_window.h",
    "ohos_screen.cc",
    "ohos_screen.h",
    "ohos_surface_factory.cc",
    "ohos_surface_factory.h",
    "ohos_vsync_provider.cc",
    "ohos_vsync_provider.h",
    "ozone_platform_ohos.cc",
    "ozone_platform_ohos.h",
  ]

  defines = [ "OZONE_IMPLEMENTATION" ]

  libs = [
    "native_display_manager",
    "native_vsync",
    "native_window",
    "ohinputmethod",
    "pasteboard",
    "udmf",
  ]

  deps = [
    ":event_source",
    ":native_window_registry",
    "//base",
    "//skia",
    "//ui/base",
    "//ui/base/cursor",
    "//ui/events",
    "//ui/events/ozone/layout",
    "//ui/events/platform",
    "//ui/gfx/geometry",
    "//ui/gl",
    "//ui/ozone:ozone_base",
    "//ui/ozone/common",
    "//ui/ozone/platform/headless",
    "//ui/platform_window",
    "//ui/platform_window/stub",
    "//ui/platform_window/wm",
  ]

  if (enable_vulkan) {
    # The Vulkan implementation this platform hands back. It lives with the
    # other platforms' under //gpu/vulkan rather than here, so that the
    # ladder in gpu/vulkan/init and this one stay recognisably the same
    # shape.
    deps += [ "//gpu/vulkan/ohos" ]
  }
}
