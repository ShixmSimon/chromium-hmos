+namespace {
+
+OhosSpeechRecognitionHandler& GetOhosSpeechRecognitionHandler() {
+  static base::NoDestructor<OhosSpeechRecognitionHandler> handler;
+  return *handler;
+}
+
+class SpeechRecognizerImplOhos;
+
+// Live recognizers by session, on the IO thread.
+std::map<int, SpeechRecognizerImplOhos*>& OhosRecognizers() {
+  static base::NoDestructor<std::map<int, SpeechRecognizerImplOhos*>> map;
+  return *map;
+}
+
+// The system's speech recognizer, run by the shell -- it captures the audio
+// itself, as Android's does, so there is no audio capture or network engine
+// here. Like SpeechRecognizerImplAndroid, it lives on the IO thread and asks
+// the UI thread to start, stop and abort.
+class SpeechRecognizerImplOhos : public SpeechRecognizer {
+ public:
+  SpeechRecognizerImplOhos(SpeechRecognitionEventListener* listener,
+                           int session_id,
+                           GlobalRenderFrameHostId frame)
+      : SpeechRecognizer(listener, session_id), frame_(frame) {}
+
+  void StartRecognition(const std::string& device_id) override {
+    DCHECK_CURRENTLY_ON(BrowserThread::IO);
+    state_ = State::kCapturing;
+    OhosRecognizers()[session_id()] = this;
+    // Posted, as Android does: the manager is still in its start transition.
+    GetIOThreadTaskRunner({})->PostTask(
+        FROM_HERE,
+        base::BindOnce(&SpeechRecognitionEventListener::OnRecognitionStart,
+                       base::Unretained(listener()), session_id()));
+    const SpeechRecognitionSessionConfig config =
+        SpeechRecognitionManager::GetInstance()->GetSessionConfig(session_id());
+    GetUIThreadTaskRunner({})->PostTask(
+        FROM_HERE,
+        base::BindOnce(
+            [](int session_id, GlobalRenderFrameHostId frame,
+               std::string language, bool continuous, bool interim) {
+              const OhosSpeechRecognitionHandler& handler =
+                  GetOhosSpeechRecognitionHandler();
+              if (handler.start) {
+                handler.start.Run(session_id, frame, language, continuous,
+                                  interim);
+              } else {
+                OnOhosSpeechRecognitionEvent(
+                    session_id, OhosSpeechEvent::kError, std::u16string(),
+                    false, 0,
+                    static_cast<int>(
+                        media::mojom::SpeechRecognitionErrorCode::
+                            kServiceNotAllowed));
+                OnOhosSpeechRecognitionEvent(session_id, OhosSpeechEvent::kEnd,
+                                             std::u16string(), false, 0, 0);
+              }
+            },
+            session_id(), frame_, config.language, config.continuous,
+            config.interim_results));
+  }
+
+  void UpdateRecognitionContext(
+      const media::SpeechRecognitionRecognitionContext& context) override {
+    // As on Android: the system recognizer takes no phrase list.
+    GetIOThreadTaskRunner({})->PostTask(
+        FROM_HERE,
+        base::BindOnce(
+            &SpeechRecognizerImplOhos::ReportError, base::WrapRefCounted(this),
+            static_cast<int>(media::mojom::SpeechRecognitionErrorCode::
+                                 kPhrasesNotSupported)));
+  }
+
+  void AbortRecognition() override {
+    DCHECK_CURRENTLY_ON(BrowserThread::IO);
+    if (state_ == State::kIdle) {
+      return;
+    }
+    // The shell answers an abort with its end event.
+    PostToHandler(&OhosSpeechRecognitionHandler::abort);
+  }
+
+  void StopAudioCapture() override {
+    DCHECK_CURRENTLY_ON(BrowserThread::IO);
+    if (state_ == State::kCapturing) {
+      PostToHandler(&OhosSpeechRecognitionHandler::stop);
+    }
+  }
+
+  bool IsActive() const override { return state_ != State::kIdle; }
+  bool IsCapturingAudio() const override {
+    return state_ == State::kCapturing;
+  }
+
+  void OnEvent(OhosSpeechEvent type,
+               const std::u16string& transcript,
+               bool is_final,
+               double confidence,
+               int error_code) {
+    DCHECK_CURRENTLY_ON(BrowserThread::IO);
+    if (state_ == State::kIdle) {
+      return;
+    }
+    switch (type) {
+      case OhosSpeechEvent::kAudioStart:
+        listener()->OnAudioStart(session_id());
+        break;
+      case OhosSpeechEvent::kSoundStart:
+        listener()->OnSoundStart(session_id());
+        break;
+      case OhosSpeechEvent::kSoundEnd:
+        listener()->OnSoundEnd(session_id());
+        break;
+      case OhosSpeechEvent::kAudioEnd:
+        state_ = State::kRecognizing;
+        listener()->OnAudioEnd(session_id());
+        break;
+      case OhosSpeechEvent::kResult: {
+        std::vector<media::mojom::WebSpeechRecognitionResultPtr> results;
+        auto result = media::mojom::WebSpeechRecognitionResult::New();
+        result->hypotheses.push_back(
+            media::mojom::SpeechRecognitionHypothesis::New(transcript,
+                                                           confidence));
+        result->is_provisional = !is_final;
+        results.push_back(std::move(result));
+        listener()->OnRecognitionResults(session_id(), results);
+        break;
+      }
+      case OhosSpeechEvent::kError:
+        ReportError(error_code);
+        break;
+      case OhosSpeechEvent::kEnd:
+        state_ = State::kIdle;
+        OhosRecognizers().erase(session_id());
+        listener()->OnRecognitionEnd(session_id());
+        break;
+    }
+  }
+
+ private:
+  enum class State { kIdle, kCapturing, kRecognizing };
+
+  ~SpeechRecognizerImplOhos() override {
+    auto it = OhosRecognizers().find(session_id());
+    if (it != OhosRecognizers().end() && it->second == this) {
+      OhosRecognizers().erase(it);
+    }
+  }
+
+  void ReportError(int error_code) {
+    DCHECK_CURRENTLY_ON(BrowserThread::IO);
+    listener()->OnRecognitionError(
+        session_id(),
+        media::mojom::SpeechRecognitionError(
+            static_cast<media::mojom::SpeechRecognitionErrorCode>(error_code),
+            media::mojom::SpeechAudioErrorDetails::kNone));
+  }
+
+  void PostToHandler(
+      base::RepeatingCallback<void(int)> OhosSpeechRecognitionHandler::*which) {
+    GetUIThreadTaskRunner({})->PostTask(
+        FROM_HERE, base::BindOnce(
+                       [](base::RepeatingCallback<void(int)>
+                              OhosSpeechRecognitionHandler::*which,
+                          int session_id) {
+                         const auto& callback =
+                             GetOhosSpeechRecognitionHandler().*which;
+                         if (callback) {
+                           callback.Run(session_id);
+                         }
+                       },
+                       which, session_id()));
+  }
+
+  const GlobalRenderFrameHostId frame_;
+  State state_ = State::kIdle;
+};
+
+}  // namespace
+
+void SetOhosSpeechRecognitionHandler(OhosSpeechRecognitionHandler handler) {
+  GetOhosSpeechRecognitionHandler() = std::move(handler);
+}
+
+void OnOhosSpeechRecognitionEvent(int session_id,
+                                  OhosSpeechEvent type,
+                                  const std::u16string& transcript,
+                                  bool is_final,
+                                  double confidence,
+                                  int error_code) {
+  GetIOThreadTaskRunner({})->PostTask(
+      FROM_HERE,
+      base::BindOnce(
+          [](int session_id, OhosSpeechEvent type, std::u16string transcript,
+             bool is_final, double confidence, int error_code) {
+            auto it = OhosRecognizers().find(session_id);
+            if (it != OhosRecognizers().end()) {
+              // A ref for the call: the end event may let the session go.
+              scoped_refptr<SpeechRecognizerImplOhos> recognizer(it->second);
+              recognizer->OnEvent(type, transcript, is_final, confidence,
+                                  error_code);
+            }
+          },
+          session_id, type, transcript, is_final, confidence, error_code));
+}
+#endif  // BUILDFLAG(IS_OHOS)
+
