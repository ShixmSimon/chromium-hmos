+  static std::vector<sk_sp<SkTypeface>> FindEmojiTypefaces(
+      const SkFontMgr& manager,
+      const std::vector<std::string>& emoji_files) {
+    std::vector<sk_sp<SkTypeface>> typefaces;
+    for (int index = 0; index < manager.countFamilies(); ++index) {
+      SkString name;
+      manager.getFamilyName(index, &name);
+      if (!name.contains("Emoji") && !name.contains("emoji")) {
+        continue;
+      }
+      sk_sp<SkFontStyleSet> styles = manager.createStyleSet(index);
+      sk_sp<SkTypeface> typeface =
+          styles ? styles->matchStyle(SkFontStyle()) : nullptr;
+      const bool color = typeface && HasColorGlyphs(*typeface);
+      LOG(INFO) << "OHOS emoji family: " << name.c_str()
+                << " color=" << color;
+      if (color) {
+        typefaces.push_back(std::move(typeface));
+      }
+    }
+    // The directory scanner can leave a bitmap-only emoji font out of the
+    // family list; load the files themselves then.
+    if (typefaces.empty()) {
+      for (const std::string& path : emoji_files) {
+        sk_sp<SkTypeface> typeface = manager.makeFromFile(path.c_str());
+        SkString name;
+        if (typeface) {
+          typeface->getFamilyName(&name);
+        }
+        const bool color = typeface && HasColorGlyphs(*typeface);
+        // Diagnostic: whether the file could be read at all, and what kind
+        // of file it starts like (00010000 / 'true' / 'OTTO' / 'ttcf').
+        std::string head;
+        if (!typeface) {
+          uint8_t bytes[8] = {};
+          const std::optional<uint64_t> read =
+              base::ReadFile(base::FilePath(path), base::span(bytes));
+          static constexpr char kHex[] = "0123456789abcdef";
+          for (uint8_t byte : bytes) {
+            head.push_back(kHex[byte >> 4]);
+            head.push_back(kHex[byte & 0xf]);
+          }
+          if (!read) {
+            head = "unreadable";
+          }
+        }
+        LOG(INFO) << "OHOS emoji file: " << path << " loaded=" << !!typeface
+                  << " family=" << name.c_str() << " color=" << color
+                  << " head=" << head;
+        if (color) {
+          typefaces.push_back(std::move(typeface));
+        }
+      }
+    }
+    LOG(INFO) << "OHOS emoji fonts: " << typefaces.size() << " of "
+              << manager.countFamilies() << " families";
+    return typefaces;
+  }
+
+  sk_sp<SkTypeface> MatchEmoji(const SkFontStyle& style,
+                               SkUnichar character) const {
+    for (const sk_sp<SkTypeface>& typeface : emoji_typefaces_) {
+      if (typeface->unicharToGlyph(character)) {
+        return typeface;
+      }
+    }
+    return nullptr;
+  }
