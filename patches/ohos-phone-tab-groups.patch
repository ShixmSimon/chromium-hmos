@@ -1128,6 +1133,18 @@
         tab.extra_data, true /* from_session_restore */, is_active_browser);
     DCHECK(web_contents);
 
+#if BUILDFLAG(IS_OHOS)
+    // Chromium does not write down who opened whom -- nothing in the session
+    // service persists an opener -- and on a phone that relation is drawn on
+    // screen and is what the back gesture follows, so the shell would lose it
+    // every time the browser was closed. It is written into the tab's extra
+    // data, and this is where it comes back: the ids in the file are the ones
+    // tabs had before the shutdown, so they are handed over with the tab that
+    // now carries each one and translated on the other side.
+    chrome::ohos::NoteRestoredPageOpener(web_contents, tab.tab_id,
