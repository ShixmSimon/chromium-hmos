+  std::string missing;
+  for (const char* name : kOhosSkiaGlobalProcs) {
+    if (!context.fGetProc(name, VK_NULL_HANDLE, VK_NULL_HANDLE)) {
+      missing += std::string(" ") + name;
+    }
+  }
+  for (const char* name : kOhosSkiaInstanceProcs) {
+    if (!context.fGetProc(name, context.fInstance, VK_NULL_HANDLE)) {
+      missing += std::string(" ") + name;
+    }
+  }
+  for (const char* name : kOhosSkiaDeviceProcs) {
+    if (!context.fGetProc(name, VK_NULL_HANDLE, context.fDevice)) {
+      missing += std::string(" ") + name;
+    }
+  }
