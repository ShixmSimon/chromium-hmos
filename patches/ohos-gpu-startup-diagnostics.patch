+void DescribeOhosSkiaVulkanFailure(
+    const skgpu::VulkanBackendContext& context,
+    const std::vector<const char*>& instance_extensions,
+    const std::vector<const char*>& device_extensions) {
+  uint32_t instance_version = 0;
+  auto enumerate_instance_version =
+      reinterpret_cast<PFN_vkEnumerateInstanceVersion>(context.fGetProc(
+          "vkEnumerateInstanceVersion", VK_NULL_HANDLE, VK_NULL_HANDLE));
+  if (enumerate_instance_version) {
+    enumerate_instance_version(&instance_version);
+  }
+  VkPhysicalDeviceProperties properties = {};
+  auto get_properties = reinterpret_cast<PFN_vkGetPhysicalDeviceProperties>(
+      context.fGetProc("vkGetPhysicalDeviceProperties", context.fInstance,
+                       VK_NULL_HANDLE));
