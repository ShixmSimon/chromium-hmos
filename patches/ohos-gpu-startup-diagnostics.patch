--- a/components/viz/common/gpu/vulkan_in_process_context_provider.cc
+++ b/components/viz/common/gpu/vulkan_in_process_context_provider.cc
@@ -127,6 +127,11 @@ bool VulkanInProcessContextProvider::Initialize(const gpu::GPUInfo* gpu_info,
     }
   }
 
+#if BUILDFLAG(IS_OHOS)
+  // Before as well as after: a device queue that never comes back looks
+  // the same as one that was never asked for.
+  LOG(ERROR) << "OHOS Vulkan: creating the device queue";
+#endif
   device_queue_ =
       gpu::CreateVulkanDeviceQueue(vulkan_implementation_, flags, gpu_info,
                                    heap_memory_limit_, is_thread_safe);
