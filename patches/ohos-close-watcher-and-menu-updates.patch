+bool WebContentsImpl::SignalCloseWatcherIfActive() {
+  OPTIONAL_TRACE_EVENT0("content",
+                        "WebContentsImpl::SignalCloseWatcherIfActive");
+  RenderFrameHostImpl* focused = GetFocusedFrame();
+  if (!focused) {
+    return false;
+  }
+  CloseListenerHost* host =
+      CloseListenerHost::GetForCurrentDocument(focused);
+  return host && host->SignalIfActive();
+}
