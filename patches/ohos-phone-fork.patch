+TerminationStatus GetOhosForkTerminationStatus(
+    const internal::OhosForkChildStatus& state,
+    int* exit_code) {
+  *exit_code = 0;
+  if (state.running)
+    return TERMINATION_STATUS_STILL_RUNNING;
+  if (state.wait_status >= 0) {
+    if (WIFSIGNALED(state.wait_status))
+      return GetOhosTerminationStatusFromSignal(WTERMSIG(state.wait_status),
+                                              exit_code);
+    if (WIFEXITED(state.wait_status)) {
+      *exit_code = WEXITSTATUS(state.wait_status);
+      return *exit_code == 0 ? TERMINATION_STATUS_NORMAL_TERMINATION
+                            : TERMINATION_STATUS_ABNORMAL_TERMINATION;
+    }
+  }
+  *exit_code = -1;
+  return TERMINATION_STATUS_ABNORMAL_TERMINATION;
+}
