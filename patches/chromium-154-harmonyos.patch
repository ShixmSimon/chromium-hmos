+
+  const bool mobile = chrome::ohos::IsAuraShellMobilePhoneUi();
+  const bool was_mobile = ohos_mobile_ui_active_;
+  if (mobile && !was_mobile) {
+    ohos_saved_bookmark_bar_visible_ =
+        bookmark_bar_view_ && bookmark_bar_view_->GetVisible();
