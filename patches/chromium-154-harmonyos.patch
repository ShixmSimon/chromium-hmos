+  // Search providers may advertise a hosted new-tab page. Chromium keeps the
+  // selected provider for omnibox searches while serving Chromium's local NTP.
+  data->new_tab_url.clear();
+
+  // Some non-Google providers use Chromium's generic path-wildcard token in
+  // their visible URL. It expands to an empty path on HarmonyOS, so store the
+  // expanded form and avoid exposing a misleading Google label in Settings.
+  constexpr std::string_view kPathWildcard = "{google:pathWildcard}";
