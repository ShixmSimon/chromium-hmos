+  ohos_mobile_ui_active_ = mobile;
+
+  if (toolbar_) {
+    toolbar_->OnOhosUiFamilyChanged();
+    // 154 moved window-feature queries onto WindowFeatureController.
+    const WindowFeatureController* window_features =
+        WindowFeatureController::From(browser_);
+    const bool supports_toolbar =
+        window_features->SupportsWindowFeature(
+            WindowFeatureController::WindowFeature::kFeatureToolbar) ||
+        window_features->SupportsWindowFeature(
+            WindowFeatureController::WindowFeature::kFeatureLocationBar);
+    toolbar_->SetVisible(!mobile && supports_toolbar);
+  }
+  if (bookmark_bar_view_) {
+    if (mobile) {
+      bookmark_bar_view_->SetVisible(false);
+    } else if (was_mobile) {
+      bookmark_bar_view_->SetVisible(ohos_saved_bookmark_bar_visible_);
+    }
+  }
+  if (BrowserFrameView* frame_view = GetFrameView()) {
+    frame_view->InvalidateLayout();
+    frame_view->UpdateMinimumSize();
+  }
+  InvalidateLayout();
+
+  if (views::Widget* widget = GetWidget()) {
+    views::View* root_view = widget->GetRootView();
+    root_view->InvalidateLayout();
+    root_view->SchedulePaint();
+  } else {
+    SchedulePaint();
+  }
+}
+#endif
