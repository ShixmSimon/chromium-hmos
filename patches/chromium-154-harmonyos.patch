+#if BUILDFLAG(IS_OHOS)
+void ToolbarView::OnOhosUiFamilyChanged() {
+  const bool should_use_mobile_phone_ui =
+      chrome::ohos::IsAuraShellMobilePhoneUi();
+  if (!should_use_mobile_phone_ui) {
+    RestoreOhosDesktopToolbar();
+    return;
+  }
+
+  if (!ohos_mobile_mode_active_) {
+    ohos_saved_child_visibility_.clear();
+    for (views::View* child : children()) {
+      if (child == ohos_mobile_toolbar_spacer_ ||
+          child == ohos_mobile_tab_switcher_button_) {
+        continue;
+      }
+      ohos_saved_child_visibility_.emplace_back(child, child->GetVisible());
+    }
+    ohos_mobile_mode_active_ = true;
+    ohos_mobile_location_bar_expanded_ = false;
+  }
+
+  UpdateOhosMobileToolbar(GetWebContents());
+}
+
+void ToolbarView::PrepareForOhosMobileLocationBarFocus() {
+  if (!ohos_mobile_mode_active_) {
+    return;
+  }
+
+  ohos_mobile_location_bar_expanded_ = true;
+  UpdateOhosMobileToolbar(GetWebContents());
+}
+
+void ToolbarView::UpdateOhosMobileToolbar(WebContents* tab) {
+  if (!ohos_mobile_mode_active_) {
+    return;
+  }
+
+  if (!tab) {
+    tab = GetWebContents();
+  }
+  const bool is_ntp = tab && search::IsNTPURL(tab->GetVisibleURL());
+  if (!is_ntp) {
+    ohos_mobile_location_bar_expanded_ = false;
+  }
+  const bool show_location_bar = !is_ntp || ohos_mobile_location_bar_expanded_;
+
+  for (views::View* child : children()) {
+    bool visible =
+        child == app_menu_button_ || child == ohos_mobile_tab_switcher_button_;
+    if (show_location_bar) {
+      visible = visible || child == back_ || child == location_bar_view_ ||
+                child == toolbar_webview_;
+    } else {
+      visible =
+          visible || child == home_ || child == ohos_mobile_toolbar_spacer_;
+    }
+    child->SetVisible(visible);
+  }
+
+  if (ohos_mobile_tab_switcher_button_) {
+    const int tab_count = std::max(1, browser_->tab_strip_model()->count());
+    ohos_mobile_tab_switcher_button_->SetText(base::FormatNumber(tab_count));
+  }
+
+  InvalidateLayout();
+  PreferredSizeChanged();
+}
+
+void ToolbarView::RestoreOhosDesktopToolbar() {
+  if (!ohos_mobile_mode_active_) {
+    return;
+  }
+
+  ohos_mobile_mode_active_ = false;
+  ohos_mobile_location_bar_expanded_ = false;
+  for (const auto& [child, was_visible] : ohos_saved_child_visibility_) {
+    child->SetVisible(was_visible);
+  }
+  ohos_saved_child_visibility_.clear();
+  if (ohos_mobile_toolbar_spacer_) {
+    ohos_mobile_toolbar_spacer_->SetVisible(false);
+  }
+  if (ohos_mobile_tab_switcher_button_) {
+    ohos_mobile_tab_switcher_button_->SetVisible(false);
+  }
+
+  InvalidateLayout();
+  PreferredSizeChanged();
+}
