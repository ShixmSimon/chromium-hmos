+  // it: no location bar to focus, no menu button to open. The shell is told
+  // instead. Chromium's accelerator table still decides which key means which
+  // command; this only decides who carries the command out.
+  if (chrome::ohos::DispatchAuraShellAccelerator(browser_, command_id)) {
