+#if defined(__OHOS__)
+TEST(VirtualAddressSpaceTest, EmulatedSharedPagesWithUnavailableUnmappedRegion) {
+  VirtualAddressSpace rootspace;
+  constexpr size_t kMappedSize = 4 * MB;
+  constexpr size_t kLogicalSize = 2 * kMappedSize;
+  const size_t page_size = rootspace.allocation_granularity();
+  // Keep the logical-but-unreserved half occupied too: the old random-hint
+  // implementation cannot place a shared mapping there. No enormous actual
+  // address-space reservation is needed to reproduce the phone's failure.
+  Address reservation = rootspace.AllocatePages(
+      VirtualAddressSpace::kNoHint, kLogicalSize, page_size,
+      PagePermissions::kNoAccess);
+  ASSERT_NE(kNullAddress, reservation);
+  {
+    EmulatedVirtualAddressSubspace subspace(&rootspace, reservation, kMappedSize,
+                                           kLogicalSize);
+    TestSharedPageAllocation(&subspace);
+    auto handle = OS::CreateSharedMemoryHandleForTesting(2 * page_size);
+    ASSERT_TRUE(handle.has_value());
+    for (int i = 0; i < 32; ++i) {
+      Address shared = subspace.AllocateSharedPages(
+          VirtualAddressSpace::kNoHint, page_size, PagePermissions::kReadWrite,
+          *handle, page_size);
+      ASSERT_GE(shared, reservation);
+      ASSERT_LE(shared + page_size, reservation + kMappedSize);
+      *reinterpret_cast<int*>(shared) = 42;
+      Address alias = subspace.AllocateSharedPages(
+          VirtualAddressSpace::kNoHint, page_size, PagePermissions::kRead,
+          *handle, page_size);
+      ASSERT_NE(kNullAddress, alias);
+      ASSERT_NE(alias, shared);
+      EXPECT_EQ(42, *reinterpret_cast<int*>(alias));
+      subspace.FreeSharedPages(alias, page_size);
+      subspace.FreeSharedPages(shared, page_size);
+      // Freeing a shared mapping must preserve its reservation and allow the
+      // same address to be reused as zero-initialized private memory.
+      Address private_page = subspace.AllocatePages(
+          shared, page_size, page_size, PagePermissions::kReadWrite);
+      ASSERT_EQ(shared, private_page);
+      EXPECT_EQ(0, *reinterpret_cast<int*>(private_page));
+      subspace.FreePages(private_page, page_size);
+    }
+    OS::DestroySharedMemoryHandle(*handle);
+    TestParentSpaceCannotAllocateInChildSpace(&rootspace, &subspace);
+  }
+  rootspace.FreePages(reservation + kMappedSize, kMappedSize);
+}
+#endif
