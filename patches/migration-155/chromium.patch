+// A sealed O_RDWR memfd is read-only for every new mapping and write syscall.
+// This is also checked when receiving an untrusted shared-memory handle.
+bool IsOhosSealedReadOnlyMemfd(int fd) {
+  constexpr int required =
+      F_SEAL_SHRINK | F_SEAL_GROW | F_SEAL_FUTURE_WRITE | F_SEAL_SEAL;
+  const int seals = fcntl(fd, F_GET_SEALS);
+  return seals >= 0 && (seals & required) == required;
+}
+
+// A writable memfd must retain the ability to add write seals at conversion.
+// F_GET_SEALS establishes this without a separate file-attribute permission.
+bool IsOhosConvertibleMemfd(int fd) {
+  const int seals = fcntl(fd, F_GET_SEALS);
+  constexpr int size_seals = F_SEAL_SHRINK | F_SEAL_GROW;
+  constexpr int final_seals = F_SEAL_SEAL | F_SEAL_WRITE | F_SEAL_FUTURE_WRITE;
+  return seals >= 0 && (seals & size_seals) == size_seals &&
+         (seals & final_seals) == 0;
+}
+
+void LogOhosSharedMemoryImportFailure(
+    FDPair handle,
+    PlatformSharedMemoryRegion::Mode mode,
+    size_t size,
+    PlatformSharedMemoryRegion::TakeError error) {
+  static std::atomic<bool> logged{false};
+  if (logged.exchange(true, std::memory_order_relaxed)) {
+    return;
+  }
+  const int flags = fcntl(handle.fd, F_GETFL);
+  const int flags_errno = flags < 0 ? errno : 0;
+  const int seals = fcntl(handle.fd, F_GET_SEALS);
+  const int seals_errno = seals < 0 ? errno : 0;
+  const int paired_flags = fcntl(handle.readonly_fd, F_GETFL);
+  const int paired_errno = paired_flags < 0 ? errno : 0;
+  LOG(ERROR) << "OHOS shared memory import rejected mode="
+             << static_cast<int>(mode) << " size=" << size
+             << " error=" << static_cast<int>(error) << " flags=" << flags
+             << " flags_errno=" << flags_errno << " seals=" << seals
+             << " seals_errno=" << seals_errno
+             << " paired_flags=" << paired_flags
+             << " paired_errno=" << paired_errno;
+}
