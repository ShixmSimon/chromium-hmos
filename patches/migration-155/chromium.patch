+  const size_t separator = os_name.find('-');
+  std::string version = separator == std::string_view::npos
+                            ? std::string()
+                            : std::string(os_name.substr(separator + 1));
+  std::vector<std::string_view> components = base::SplitStringPiece(
+      version, ".", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+  std::string major_minor =
+      components.size() >= 2
+          ? base::StrCat({components[0], ".", components[1]})
