Keep tab-modal dialogs between the shell's top bar and dock.

A tab-modal dialog -- the extension and theme install confirmations, and the
other dialogs Chromium shows over a tab -- hangs from the bottom of the Views
toolbar. This port has no Views toolbar on screen: its browser UI is drawn in
ArkTS over the page, so the dialog went to the very top of the window, under
the status bar and the shell's address bar, with only its buttons showing and
taps on them taken by the address bar (measured on a Mate 70 Pro+ with an
extension install from www.crxsoso.com).

On OHOS TabModalDialogHost keeps the dialog's top at or below the shell's top
bar and its maximum height within the room above the dock and the gesture
bar, both as the shell reported them to the bridge. While a tab is blocked by
such a dialog, the bridge holds the top bar and dock shown, so that room is
the room there is; they go back to following the page when it closes.

Generated against Chromium 154.0.8037.51.

Apply with:
  git -C /path/to/chromium/src apply /path/to/patches/ohos-tab-modal-shell-insets.patch

diff --git a/chrome/browser/ui/views/frame/tab_modal_dialog_host.cc b/chrome/browser/ui/views/frame/tab_modal_dialog_host.cc
index 7ad0e2b..3e89dba 100644
--- a/chrome/browser/ui/views/frame/tab_modal_dialog_host.cc
+++ b/chrome/browser/ui/views/frame/tab_modal_dialog_host.cc
@@ -23,6 +23,12 @@
 #include "ui/views/view.h"
 #include "ui/views/widget/widget.h"
 
+#include "build/build_config.h"
+
+#if BUILDFLAG(IS_OHOS)
+#include "chrome/browser/ui/ohos/aura_shell_runtime_bridge.h"
+#endif
+
 namespace {
 // The number of pixels the constrained window should overlap the bottom
 // of the omnibox.
@@ -55,10 +61,21 @@ gfx::Point TabModalDialogHost::GetDialogPosition(const gfx::Size& dialog_size) {
   const int leading_x = contents_container_view_coordinates_in_browser.x();
   const int middle_x = leading_x + contents_container_view_->width() / 2;
   const int dialog_starting_x = std::max(middle_x - dialog_size.width() / 2, 0);
+  int dialog_y =
+      GetDialogYCoordinate(contents_container_view_coordinates_in_browser.y(),
+                           dialog_size.height());
+#if BUILDFLAG(IS_OHOS)
+  // The browser UI is the shell's, drawn in ArkTS over the page: there is no
+  // Views toolbar to hang the dialog from, and the shell's top bar covers
+  // the top of the window. Keep the dialog below that bar, as it would hang
+  // below Chrome's toolbar; GetMaximumDialogSize() keeps it above the dock.
+  dialog_y = std::max(dialog_y, chrome::ohos::GetAuraShellModalDialogInsets(
+                                    browser_view_->browser())
+                                    .top());
+#endif
   return gfx::Point(
       std::min(dialog_starting_x, browser_view_->width() - dialog_size.width()),
-      GetDialogYCoordinate(contents_container_view_coordinates_in_browser.y(),
-                           dialog_size.height()));
+      dialog_y);
 }
 
 bool TabModalDialogHost::ShouldActivateDialog() const {
@@ -100,9 +117,22 @@ gfx::Size TabModalDialogHost::GetMaximumDialogSize() {
   // clipping when the content_area becomes too small for the dialog. This will
   // cause the dialog to extend beyond its corresponding content_area but remain
   // the bounds of the browser view contents container.
+#if BUILDFLAG(IS_OHOS)
+  // Between the shell's top bar and its dock (see GetDialogPosition()). A
+  // dialog taller than that scrolls or lays itself out shorter instead of
+  // running under either.
+  const gfx::Insets shell =
+      chrome::ohos::GetAuraShellModalDialogInsets(browser_view_->browser());
+  return gfx::Size(
+      browser_view_->contents_container()->width(),
+      std::max(0, std::min(contents_container_area.bottom() -
+                               GetToolbarOverlappingYCoordinate(),
+                           browser_view_->height() - shell.height())));
+#else
   return gfx::Size(
       browser_view_->contents_container()->width(),
       contents_container_area.bottom() - GetToolbarOverlappingYCoordinate());
+#endif
 }
 
 void TabModalDialogHost::OnViewAddedToWidget(views::View* observed_view) {
