+namespace {
+
+// Items a phone has nowhere to put. Inspect and view-source want a devtools
+// window; save-as-a-page, print and cast want a file picker, a printer or a
+// second screen the reader is not looking at; a second browser window is not
+// a thing that exists on a phone, and neither is a split view. Translation
+// goes when the toolbar that drives it is not on screen.
+//
+// A remove-list rather than a keep-list on purpose: the menu also carries
+// cut, copy, paste, select-all, spelling and the input-method items, and a
+// keep-list would have to name all of them or quietly break every text field.
+constexpr int kNotOnAPhone[] = {
+    IDC_CONTENT_CONTEXT_INSPECTELEMENT,
+    IDC_CONTENT_CONTEXT_INSPECTELEMENT_WITH_DEVTOOLS,
+    IDC_CONTENT_CONTEXT_INSPECTBACKGROUNDPAGE,
+    IDC_CONTENT_CONTEXT_VIEWFRAMESOURCE,
+    IDC_CONTENT_CONTEXT_RELOADFRAME,
+    IDC_CONTENT_CONTEXT_OPENLINKNEWWINDOW,
+    IDC_CONTENT_CONTEXT_OPENLINKSPLITVIEW,
+    IDC_CONTENT_CONTEXT_TRANSLATE,
+    IDC_VIEW_SOURCE,
+    IDC_SAVE_PAGE,
+    IDC_PRINT,
+    IDC_ROUTE_MEDIA,
+};
+
+bool IsNotOnAPhone(int command_id) {
+  for (int id : kNotOnAPhone) {
+    if (id == command_id) {
+      return true;
+    }
+  }
+  return false;
+}
+
+// Drops those items and any separator left with nothing on one side of it.
+void TrimMenuForPhone(ui::SimpleMenuModel* model) {
+  for (size_t index = model->GetItemCount(); index > 0; --index) {
+    const size_t at = index - 1;
+    if (model->GetTypeAt(at) != ui::MenuModel::TYPE_SEPARATOR &&
+        IsNotOnAPhone(model->GetCommandIdAt(at))) {
+      model->RemoveItemAt(at);
+    }
+  }
+  // Leading, trailing and doubled separators, back to front so the indices
+  // behind the one being removed stay put.
+  bool next_is_separator = true;  // The end counts as one.
+  for (size_t index = model->GetItemCount(); index > 0; --index) {
+    const size_t at = index - 1;
+    const bool separator =
+        model->GetTypeAt(at) == ui::MenuModel::TYPE_SEPARATOR;
+    if (separator && next_is_separator) {
+      model->RemoveItemAt(at);
+      continue;
+    }
+    next_is_separator = separator;
+  }
+  if (model->GetItemCount() > 0 &&
+      model->GetTypeAt(0) == ui::MenuModel::TYPE_SEPARATOR) {
+    model->RemoveItemAt(0);
+  }
+}
+
+}  // namespace
+#endif  // BUILDFLAG(IS_OHOS)
