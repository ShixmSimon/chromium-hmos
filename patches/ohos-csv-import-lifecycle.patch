+  LOG(ERROR) << "OHOS CSV import parser failed timeout=" << timed_out;
+  state_ = kNotStarted;
+  ImportResults results;
+  results.status = ImportResults::Status::UNKNOWN_ERROR;
+  results.file_name = file_path_.BaseName().AsUTF8Unsafe();
+  std::move(pending_parse_callback_).Run(results);
+}
