 #include "base/no_destructor.h"
@@ -80,2 +82,20 @@
 
+bool CrowdDenyPreloadData::ShouldWarnAboutNotifications(
+    const url::Origin& origin) const {
+  if (!is_ready_to_use_)
+    return false;
+  const SiteReputation* reputation = GetReputationDataForSite(origin);
+  if (!reputation)
+    return false;
+  switch (reputation->notification_ux_quality()) {
+    case SiteReputation::UNSOLICITED_PROMPTS:
+    case SiteReputation::ABUSIVE_PROMPTS:
+    case SiteReputation::ABUSIVE_CONTENT:
+    case SiteReputation::DISRUPTIVE_BEHAVIOR:
+      return true;
+    default:
+      return false;
+  }
+}
