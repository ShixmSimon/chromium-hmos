 namespace {
 
+#if BUILDFLAG(IS_OHOS)
+// Where the shell drew the button this bubble should point at.
+//
+// With the shell drawing the browser there is no Chromium toolbar, so there
+// is no ExtensionsContainerViews and no anchor view -- and the dialog fell
+// back to a browser-modal box in the middle of the window, which is not what
+// "added to the browser" should look like.
+//
+// The shell does draw those buttons and reports where they are, under the
+// same two names Chromium's own rule distinguishes: one extension points at
+// that extension's button, anything else at the extensions button. Falls
+// back from the first to the second, because an extension that is not
+// pinned has no button of its own -- which is what
+// GetReferenceButtonForPopup() does on desktop.
+//
+// Empty when the shell has said nothing, and then the modal is still right.
+gfx::Rect GetOhosShellAnchorRect(
+    gfx::NativeWindow parent,
+    const std::vector<extensions::ExtensionId>& extension_ids) {
+  if (!parent || !chrome::ohos::IsAuraShellChromeHiddenByShell()) {
+    return gfx::Rect();
+  }
+  aura::Window* const root = parent->GetRootWindow();
+  if (!root || !root->GetHost()) {
+    return gfx::Rect();
+  }
+  const gfx::AcceleratedWidget widget = root->GetHost()->GetAcceleratedWidget();
+
+  gfx::Rect rect;
+  if (extension_ids.size() == 1) {
+    rect = chrome::ohos::GetAuraShellAnchorRect(
+        widget, base::StrCat({"extension:", extension_ids[0]}));
+  }
+  if (rect.IsEmpty()) {
+    rect = chrome::ohos::GetAuraShellAnchorRect(widget, "extensions");
+  }
+  if (rect.IsEmpty()) {
+    return rect;
+  }
+  // The shell reports the button in its window's own coordinates; a bubble
+  // anchors in screen ones.
+  const gfx::Rect reported = rect;
+  rect.Offset(root->GetBoundsInScreen().OffsetFromOrigin());
+  // Diagnostic: the shell still sees the "added" bubble away from its
+  // button, and from outside it cannot be told which of these is off.
+  LOG(WARNING) << "OHOS extension bubble anchor: reported="
+               << reported.ToString()
+               << " root=" << root->GetBoundsInScreen().ToString()
+               << " anchor=" << rect.ToString();
+  return rect;
+}
+#endif  // BUILDFLAG(IS_OHOS)
+
