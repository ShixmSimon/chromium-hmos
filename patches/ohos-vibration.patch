Wire the web Vibration API to HarmonyOS SensorServiceKit.

The platform implementation is new code under
overlay/services/device/vibration/, so this patch only changes upstream-owned
files:

  * services/device/vibration/BUILD.gn builds the OHOS manager and links
    libohvibrator.z.so.
  * DeviceService binds the OHOS manager instead of the no-op base class.
  * VibrationManagerImpl::Cancel forwards to PlatformCancel(). Without this,
    leaving a page or calling navigator.vibrate(0) cannot stop the motor; the
    existing Android override is unreachable for the same reason.

Generated for Chromium 154.0.8037.51 after chromium-154-harmonyos.patch. Apply
this patch once to a persistent runner whose main adapter patch is already
present:

  git -C /path/to/chromium/src apply /path/to/patches/ohos-vibration.patch

diff --git a/services/device/device_service.cc b/services/device/device_service.cc
--- a/services/device/device_service.cc
+++ b/services/device/device_service.cc
@@ -45,6 +45,10 @@
 #include "services/device/hid/input_service_linux.h"
 #endif
 
+#if BUILDFLAG(IS_OHOS)
+#include "services/device/vibration/vibration_manager_ohos.h"
+#endif
+
 namespace device {
 
 DeviceServiceParams::DeviceServiceParams() = default;
@@ -204,6 +208,8 @@ void DeviceService::BindVibrationManager(
     mojo::PendingRemote<mojom::VibrationManagerListener> listener) {
 #if BUILDFLAG(IS_ANDROID)
   VibrationManagerAndroid::Create(std::move(receiver), std::move(listener));
+#elif BUILDFLAG(IS_OHOS)
+  VibrationManagerOhos::Create(std::move(receiver), std::move(listener));
 #else
   VibrationManagerImpl::Create(std::move(receiver), std::move(listener));
 #endif
diff --git a/services/device/vibration/BUILD.gn b/services/device/vibration/BUILD.gn
--- a/services/device/vibration/BUILD.gn
+++ b/services/device/vibration/BUILD.gn
@@ -38,4 +38,13 @@ source_set("vibration") {
 
     deps += [ "//services/device/vibration/android:vibration_jni_headers" ]
   }
+
+  if (is_ohos) {
+    sources += [
+      "vibration_manager_ohos.cc",
+      "vibration_manager_ohos.h",
+    ]
+
+    libs = [ "ohvibrator.z" ]
+  }
 }
diff --git a/services/device/vibration/vibration_manager_impl.cc b/services/device/vibration/vibration_manager_impl.cc
--- a/services/device/vibration/vibration_manager_impl.cc
+++ b/services/device/vibration/vibration_manager_impl.cc
@@ -36,6 +36,7 @@ void VibrationManagerImpl::Vibrate(int64_t milliseconds,
 }
 
 void VibrationManagerImpl::Cancel(CancelCallback callback) {
+  PlatformCancel();
   VibrationManagerImpl::cancelled_for_testing_ = true;
   std::move(callback).Run();
 }
