diff --git a/third_party/blink/renderer/build/scripts/templates/macros.tmpl b/third_party/blink/renderer/build/scripts/templates/macros.tmpl
index 5e483b4a9a..f3740f3b93 100644
--- a/third_party/blink/renderer/build/scripts/templates/macros.tmpl
+++ b/third_party/blink/renderer/build/scripts/templates/macros.tmpl
@@ -90,21 +90,5 @@ case {{ length }}:
 {%- endmacro %}
 
 {%- macro platform_buildflag(platform) -%}
-{#- OHOS is an exclusive platform: IS_ANDROID, IS_LINUX and the rest are all 0
-    for it. A feature whose status is a per-platform dict therefore lands in the
-    "default" arm, and a dict with no "default" key means disabled -- which
-    silently turned off every such feature, Element.ariaNotify and
-    window.EyeDropper among them. Linux rather than Android: EyeDropperAPI and
-    a dozen more are off on Android but stable on Linux, and Android would turn
-    WebBluetooth/WebNFC/ContactsManager on, whose device-service backends do
-    not exist here -- the same shape that crashed the browser via WebHID and
-    Web Serial. Tie OHOS to Linux here rather than
-    annotating each feature, so the mapping keeps following upstream as
-    features come and go. The default arm negates this same macro, so the two
-    arms stay mutually exclusive. -#}
-{%- if platform == 'Linux' -%}
-(BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_OHOS))
-{%- else -%}
 BUILDFLAG(IS_{{platform | upper}})
-{%- endif -%}
 {%- endmacro -%}
