 }
 
+#if BUILDFLAG(IS_OHOS)
+namespace {
+
+OhosPopupMenuHandler& GetOhosPopupMenuHandler() {
+  static base::NoDestructor<OhosPopupMenuHandler> handler;
+  return *handler;
+}
+
+}  // namespace
+
+void SetOhosPopupMenuHandler(OhosPopupMenuHandler handler) {
+  GetOhosPopupMenuHandler() = std::move(handler);
+}
+#endif  // BUILDFLAG(IS_OHOS)
+
 void RenderFrameHostImpl::ShowPopupMenu(
     mojo::PendingRemote<blink::mojom::PopupMenuClient> popup_client,
     const gfx::Rect& bounds,
@@ -10044,6 +10066,19 @@ void RenderFrameHostImpl::ShowPopupMenu(
   view->ShowPopupMenu(this, std::move(popup_client), transformed_bounds,
                       font_size, selected_item, std::move(menu_items),
                       right_aligned, allow_multiple_selection);
+#elif BUILDFLAG(IS_OHOS)
+  // The renderer only sends this when the engine turned on external popups
+  // (kOhosExternalPopupMenus); the shell shows its own picker. Nothing to
+  // show it with, or a page that is not on screen, cancels as above.
+  OhosPopupMenuHandler& handler = GetOhosPopupMenuHandler();
+  if (!IsActive() || delegate()->GetVisibility() != Visibility::VISIBLE ||
+      !handler) {
+    mojo::Remote<blink::mojom::PopupMenuClient>(std::move(popup_client))
+        ->DidCancel();
+    return;
+  }
+  handler.Run(this, std::move(popup_client), selected_item,
+              std::move(menu_items), allow_multiple_selection);
 #endif
 }
 
