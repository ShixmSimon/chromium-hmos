Say how long viz takes to acknowledge a video frame, on OHOS.

ohos-video-render-diagnostics.patch followed YouTube's 1080p60 HDR from the
decoder to VideoRendererImpl::Render() on a Mate 70 Pro+ and found nothing
late: regular timestamps, a full queue, Render() every 16.6 ms asked to
cover 16.6 ms. Yet a third of the frames dropped at 1080p, about 7% at 720p
and 2% at 240p. VideoFrameSubmitter submits nothing for a begin-frame that
arrives while its previous frame is still unacknowledged, so the frame
chosen for it is never put, and the renderer counts it dropped.

On OHOS VideoFrameSubmitter logs, every 300 acknowledgements ("OHOS video
submit"), the average and longest time from SubmitCompositorFrame() to
DidReceiveCompositorFrameAck(), how many took over 16.7 ms, and how many
begin-frames submitted nothing while waiting for one.

Generated against Chromium 154.0.8037.51.

Apply with:
  git -C /path/to/chromium/src apply /path/to/patches/ohos-video-submit-diagnostics.patch

diff --git a/third_party/blink/renderer/platform/graphics/video_frame_submitter.cc b/third_party/blink/renderer/platform/graphics/video_frame_submitter.cc
index 023a363..927ccce 100644
--- a/third_party/blink/renderer/platform/graphics/video_frame_submitter.cc
+++ b/third_party/blink/renderer/platform/graphics/video_frame_submitter.cc
@@ -17,6 +17,13 @@
 #include "base/threading/platform_thread.h"
 #include "base/trace_event/trace_event.h"
 #include "build/build_config.h"
+
+#if BUILDFLAG(IS_OHOS)
+#include <algorithm>
+
+#include "base/logging.h"
+#include "base/time/time.h"
+#endif
 #include "cc/metrics/video_playback_roughness_reporter.h"
 #include "components/viz/common/quads/compositor_frame_metadata.h"
 #include "components/viz/common/resources/resource_id.h"
@@ -45,6 +52,59 @@ namespace blink {
 
 namespace {
 
+#if BUILDFLAG(IS_OHOS)
+// How long viz takes to acknowledge a submitted video frame, logged every
+// 300 acknowledgements ("OHOS video submit"). A begin-frame that arrives
+// while the previous frame is unacknowledged submits nothing, so the frame
+// chosen for it is never shown and VideoRendererImpl counts it dropped.
+// YouTube's 1080p60 HDR dropped about a third of its frames on a Mate 70
+// Pro+ with every frame decoded, queued and chosen in time, about 2% at
+// 240p and 7% at 720p. All submitters live on the VideoFrameCompositor
+// thread, so the counts need no lock.
+struct OhosSubmitStats {
+  base::TimeTicks submitted;
+  int acked = 0;
+  int over_a_frame = 0;
+  int skipped_for_ack = 0;
+  base::TimeDelta total;
+  base::TimeDelta max;
+};
+
+OhosSubmitStats& GetOhosSubmitStats() {
+  static OhosSubmitStats stats;
+  return stats;
+}
+
+void RecordOhosAck() {
+  OhosSubmitStats& stats = GetOhosSubmitStats();
+  if (stats.submitted.is_null()) {
+    return;
+  }
+  const base::TimeDelta latency = base::TimeTicks::Now() - stats.submitted;
+  stats.submitted = base::TimeTicks();
+  ++stats.acked;
+  stats.total += latency;
+  stats.max = std::max(stats.max, latency);
+  if (latency > base::Microseconds(16667)) {
+    ++stats.over_a_frame;
+  }
+  if (stats.acked < 300) {
+    return;
+  }
+  LOG(WARNING) << "OHOS video submit: " << stats.acked
+               << " frames acknowledged, avg "
+               << (stats.total / stats.acked).InMillisecondsF() << " ms, max "
+               << stats.max.InMillisecondsF() << " ms, " << stats.over_a_frame
+               << " over 16.7 ms; " << stats.skipped_for_ack
+               << " begin-frames submitted nothing waiting for one";
+  stats.acked = 0;
+  stats.over_a_frame = 0;
+  stats.skipped_for_ack = 0;
+  stats.total = base::TimeDelta();
+  stats.max = base::TimeDelta();
+}
+#endif  // BUILDFLAG(IS_OHOS)
+
 // If enabled, every VideoFrameSubmitter will share a FrameSinkBundle with every
 // other VideoFrameSubmitter living on the same thread with the same parent
 // FrameSinkId. This is used to aggregate Viz communication and substantially
@@ -381,6 +441,9 @@ void VideoFrameSubmitter::DidReceiveCompositorFrameAck(
   }
 
   --waiting_for_compositor_ack_;
+#if BUILDFLAG(IS_OHOS)
+  RecordOhosAck();
+#endif
 }
 
 void VideoFrameSubmitter::OnBeginFrame(
@@ -812,6 +875,9 @@ bool VideoFrameSubmitter::SubmitFrame(
   // We can't delay frame size changes even if we have a pending compositor ACK
   // because a relayout signal is already in flight on the main thread.
   if (waiting_for_compositor_ack_ > 0 && !frame_size_changed) {
+#if BUILDFLAG(IS_OHOS)
+    ++GetOhosSubmitStats().skipped_for_ack;
+#endif
     return false;
   }
 
@@ -854,6 +920,11 @@ bool VideoFrameSubmitter::SubmitFrame(
   NotifyOpacityIfNeeded(new_opacity);
 
   ++waiting_for_compositor_ack_;
+#if BUILDFLAG(IS_OHOS)
+  if (GetOhosSubmitStats().submitted.is_null()) {
+    GetOhosSubmitStats().submitted = base::TimeTicks::Now();
+  }
+#endif
   return true;
 }
 
