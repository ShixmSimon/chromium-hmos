+                auto* load = use.instruction->As<core::ir::Load>();
+                if (!load || load->Result()->NumUsages() != 0) {
+                    return Failure{"Unexpected separate YCbCr sampler use after combining"};
+                }
+                load->Destroy();
+            }
+            sampler->Destroy();
+        }
