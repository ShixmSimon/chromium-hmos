+                        image_type, spirv::BuiltinFn::kOpImage,
+                        Vector<core::ir::TemplateParameter, 1>{image_type},
+                        Vector<core::ir::Value*, 1>{sampled->Result()});
+                    load->Result()->ReplaceAllUsesWith(extract->Result());
+                });
