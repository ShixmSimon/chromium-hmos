+                               ->StoreType()->As<spirv::type::Image>();
+        auto* combined = b.Var(ty.ptr(core::AddressSpace::kHandle,
+                                     ty.Get<spirv::type::SampledImage>(image_type)));
+        combined->SetBindingPoint(binding->texture.group, binding->texture.binding);
+        combined->InsertBefore(image);
