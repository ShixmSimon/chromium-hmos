+        Vector<spirv::ir::BuiltinCall*, 8> pairs;
+        for (auto* inst : module.Instructions()) {
+            auto* call = inst->As<spirv::ir::BuiltinCall>();
+            if (call && call->Func() == spirv::BuiltinFn::kOpSampledImage &&
+                loaded_var(call->Args()[0]) == image) {
+                if (!sampler || loaded_var(call->Args()[1]) != sampler) {
+                    return Failure{"YCbCr sampling must use its paired immutable sampler"};
+                }
+                pairs.Push(call);
+            }
+        }
+        for (auto* call : pairs) {
+            auto* load = b.Load(combined);
