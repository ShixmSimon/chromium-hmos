+// Merely assigning separate image/sampler variables the same binding does not
+// satisfy VUID-RuntimeSpirv-OpTypeImage-12204 / OpTypeSampler-12203.
+Result<SuccessType> CombineYCbCrResources(core::ir::Module& module,
+                                        const Options& options) {
+    core::ir::Builder b{module};
+    auto& ty = module.Types();
+    auto loaded_var = [](core::ir::Value* value) -> core::ir::Var* {
+        auto* result = value->As<core::ir::InstructionResult>();
+        auto* load = result ? result->Instruction()->As<core::ir::Load>() : nullptr;
+        auto* pointer = load ? load->From()->As<core::ir::InstructionResult>() : nullptr;
+        return pointer ? pointer->Instruction()->As<core::ir::Var>() : nullptr;
+    };
+
+    for (const auto& entry : options.bindings.external_texture) {
+        const auto* binding = std::get_if<ExternalYCBCRTexture>(&entry.second);
+        if (!binding) {
+            continue;
+        }
+        if (binding->texture != binding->sampler) {
+            return Failure{"YCbCr image and sampler must share a combined binding"};
+        }
+        core::ir::Var* image = nullptr;
+        core::ir::Var* sampler = nullptr;
+        for (auto* inst : *module.root_block) {
+            auto* var = inst->As<core::ir::Var>();
+            if (!var || var->BindingPoint() != binding->texture) {
+                continue;
+            }
