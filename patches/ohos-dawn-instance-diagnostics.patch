+ResultOrError<VkImage> CreateOhosVkImage(
+    Device* device,
+    const SharedTextureMemoryProperties& properties,
+    const VkPhysicalDeviceImageFormatInfo2& imageFormatInfo,
+    uint64_t externalFormat) {
+    struct OhosExternalFormat {
+        VkStructureType sType;
+        const void* pNext;
+        uint64_t externalFormat;
+    } externalFormatInfo{static_cast<VkStructureType>(1000452005), nullptr,
+                         externalFormat};
+    VkExternalMemoryImageCreateInfo externalMemory = {};
+    externalMemory.sType = VK_STRUCTURE_TYPE_EXTERNAL_MEMORY_IMAGE_CREATE_INFO;
+    externalMemory.pNext = externalFormat ? &externalFormatInfo : nullptr;
+    VkImageCreateInfo createInfo = {};
+    createInfo.sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO;
+    createInfo.pNext = &externalMemory;
+    createInfo.flags = imageFormatInfo.flags;
+    createInfo.imageType = VK_IMAGE_TYPE_2D;
+    createInfo.format = imageFormatInfo.format;
+    createInfo.extent = {properties.size.width, properties.size.height, 1};
+    createInfo.mipLevels = createInfo.arrayLayers = 1;
+    createInfo.samples = VK_SAMPLE_COUNT_1_BIT;
+    createInfo.tiling = VK_IMAGE_TILING_OPTIMAL;
+    createInfo.usage = imageFormatInfo.usage;
+    createInfo.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+    createInfo.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+    VkImage image = VK_NULL_HANDLE;
+    ::VkResult result = VK_ERROR_FORMAT_NOT_SUPPORTED;
+    for (uint32_t handleType :
+         {kOhosNativeBufferHandleType, kOhosNativeBufferHandleTypeDeprecated}) {
+        externalMemory.handleTypes = handleType;
+        result = device->fn.CreateImage(device->GetVkDevice(), &createInfo, nullptr, &*image);
+        if (result == VK_SUCCESS ||
+            (result != VK_ERROR_INVALID_EXTERNAL_HANDLE &&
+             result != VK_ERROR_FORMAT_NOT_SUPPORTED)) {
+            break;
+        }
+    }
+    DAWN_TRY(CheckVkSuccess(result, "vkCreateImage(OH_NativeBuffer)"));
+    return image;
+}
 #endif  // defined(__OHOS__)
 
