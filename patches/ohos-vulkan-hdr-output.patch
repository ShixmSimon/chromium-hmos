+bool VulkanSwapChain::SetHdrMetadata(const VkHdrMetadataEXT& metadata) {
+  base::AutoLock lock(lock_);
+  if (!swap_chain_ || !device_queue_->enabled_extensions().contains(
+                          VK_EXT_HDR_METADATA_EXTENSION_NAME))
+    return false;
+  const VkDevice device = device_queue_->GetVulkanDevice();
+  auto set_metadata = reinterpret_cast<PFN_vkSetHdrMetadataEXT>(
+      vkGetDeviceProcAddr(device, "vkSetHdrMetadataEXT"));
+  if (!set_metadata)
+    return false;
+  set_metadata(device, 1, &swap_chain_, &metadata);
+  return true;  // Vulkan has no readback API; physical output is a device test.
+}
 
