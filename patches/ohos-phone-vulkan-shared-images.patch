+
+#if BUILDFLAG(IS_OHOS)
+// A broken optional disk cache must not take the GPU down. Restore the table
+// after the error to verify that neither reads nor writes reuse that backend.
+TEST_F(GpuPersistentCacheTest, PermanentDiskErrorRetiresBackend) {
+  InitializeCache();
+  auto* backend = static_cast<persistent_cache::SqliteBackendImpl*>(
+      const_cast<persistent_cache::PersistentCache&>(
+          cache_->GetPersistentCacheForTesting()).GetBackendForTesting());
+  ASSERT_OK(backend->ExecuteStatementForTesting("DROP TABLE entries"));
+  EXPECT_EQ(cache_->FindKey("missing"), 0u);
+  ASSERT_OK(backend->ExecuteStatementForTesting(
+      "CREATE TABLE entries(key BLOB PRIMARY KEY UNIQUE NOT NULL, "
+      "content BLOB NOT NULL, input_signature INTEGER, write_timestamp INTEGER)"));
+  const std::string key = "after_failure";
+  const std::string value = "recompiled_shader";
+  cache_->StoreData(key, base::as_byte_span(value));
+  std::vector<uint8_t> buffer(value.size());
+  EXPECT_EQ(cache_->LoadData(key, buffer), value.size());
+  EXPECT_EQ(std::string(buffer.begin(), buffer.end()), value);
+  // Memory remains usable; the retired disk cache was not written again.
+  auto disk_result = backend->Find(base::as_byte_span(key),
+      [](size_t) { return base::span<uint8_t>(); });
+  ASSERT_TRUE(disk_result.has_value());
+  EXPECT_FALSE(disk_result->has_value());
+}
+#endif
 
