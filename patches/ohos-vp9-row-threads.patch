+// How long vpx_codec_decode takes per frame, logged every 300 frames. A
+// phone decodes 10-bit VP9 in software here -- upstream builds mobile
+// Android without it -- and at 60 fps a frame has 16.7 ms: YouTube's
+// 1080p60 HDR dropped 1% of its frames on one video and 30% on another
+// with the decode thread about half busy on both, so what matters is how
+// many frames go over, not the average.
+struct OhosDecodeTimes {
+  base::Lock lock;
+  int frames = 0;
+  int over_budget = 0;
+  base::TimeDelta total;
+  base::TimeDelta max;
+};
+
+void RecordOhosDecodeTime(base::TimeDelta elapsed, int width, int height) {
+  static base::NoDestructor<OhosDecodeTimes> times;
+  base::AutoLock hold(times->lock);
+  ++times->frames;
+  times->total += elapsed;
+  times->max = std::max(times->max, elapsed);
+  if (elapsed > base::Microseconds(16667)) {
+    ++times->over_budget;
+  }
+  if (times->frames < 300) {
+    return;
+  }
+  LOG(WARNING) << "OHOS vpx decode: " << width << "x" << height << ", "
+               << times->frames << " frames, avg "
+               << (times->total / times->frames).InMillisecondsF()
+               << " ms, max " << times->max.InMillisecondsF() << " ms, "
+               << times->over_budget << " over 16.7 ms";
+  times->frames = 0;
+  times->over_budget = 0;
+  times->total = base::TimeDelta();
+  times->max = base::TimeDelta();
+}
+
+// HarmonyOS schedules threads by QoS level, not by the nice value base
+// sets for a thread type. The decode ran on a thread pool thread that was
+// runnable but not running half the time, and even 426x240 took 3-7 ms a
+// frame. Raise the thread to QOS_USER_INTERACTIVE for the length of one
+// decode and put it back after: it is a pool thread, shared with other
+// work. libqos.so is opened rather than linked so a system without it only
+// loses the raise.
+class ScopedOhosDecodeQoS {
+ public:
+  ScopedOhosDecodeQoS() {
+    const Functions& functions = GetFunctions();
+    if (functions.set) {
+      raised_ = functions.set(kQoSUserInteractive) == 0;
+    }
+  }
+  ScopedOhosDecodeQoS(const ScopedOhosDecodeQoS&) = delete;
+  ScopedOhosDecodeQoS& operator=(const ScopedOhosDecodeQoS&) = delete;
+  ~ScopedOhosDecodeQoS() {
+    if (raised_) {
+      GetFunctions().reset();
+    }
+  }
+
+ private:
+  // QoS_Level's QOS_USER_INTERACTIVE, from <qos/qos.h>.
+  static constexpr int kQoSUserInteractive = 5;
+
+  struct Functions {
+    int (*set)(int) = nullptr;
+    int (*reset)() = nullptr;
+  };
+
+  static const Functions& GetFunctions() {
+    static const base::NoDestructor<Functions> functions([] {
+      Functions loaded;
+      if (void* library = dlopen("libqos.so", RTLD_NOW | RTLD_LOCAL)) {
+        loaded.set = reinterpret_cast<int (*)(int)>(
+            dlsym(library, "OH_QoS_SetThreadQoS"));
+        loaded.reset = reinterpret_cast<int (*)()>(
+            dlsym(library, "OH_QoS_ResetThreadQoS"));
+      }
+      if (!loaded.set || !loaded.reset) {
+        loaded = Functions();
+      }
+      const int probe = loaded.set ? loaded.set(kQoSUserInteractive) : -1;
+      if (probe == 0) {
+        loaded.reset();
+      }
+      LOG(WARNING) << "OHOS vpx decode: thread QoS "
+                   << (!loaded.set     ? "unavailable"
+                       : probe == 0    ? "raised while decoding"
+                                       : "refused");
+      return loaded;
+    }());
+    return *functions;
+  }
+
+  bool raised_ = false;
+};
+
+}  // namespace
+#endif  // BUILDFLAG(IS_OHOS)
