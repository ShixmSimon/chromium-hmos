+        // Falls through to the upstream lookup below.
+    }
+    else if (strncmp(name, "egl", 3) == 0)
+    {
+        if (void *exported = dlsym(nativeEGLHandle, name))
+        {
+            return exported;
+        }
+    }
+    else if (strncmp(name, "gl", 2) == 0)
+    {
+        static void *gles = dlopen("libGLESv3.so", RTLD_NOW | RTLD_LOCAL);
+        if (gles != nullptr)
+        {
+            if (void *exported = dlsym(gles, name))
+            {
+                return exported;
+            }
+        }
+    }
+#endif
     void *f = reinterpret_cast<void *>(mGetProcAddressPtr(name));
     if (f)
