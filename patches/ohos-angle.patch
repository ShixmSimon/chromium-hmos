+// HarmonyOS's own buffer type, as the system EGL imports it with
+// EGL_NATIVE_BUFFER_OHOS. The image is created by ImageEGL with the target
+// and this buffer passed straight through; this only tells the frontend
+// what it is. YUV buffers (NV12, P010) are sampled through
+// GL_TEXTURE_EXTERNAL_OES with the driver converting them.
+class NativeBufferImageSiblingOHOS : public ExternalImageSiblingEGL
+{
+  public:
+    explicit NativeBufferImageSiblingOHOS(EGLClientBuffer buffer)
+        : mBuffer(static_cast<OHNativeWindowBuffer *>(buffer)), mFormat(GL_NONE)
+    {
+        OH_NativeWindow_NativeObjectReference(mBuffer);
+    }
+    ~NativeBufferImageSiblingOHOS() override
+    {
+        OH_NativeWindow_NativeObjectUnreference(mBuffer);
+    }
+
+    egl::Error initialize(const egl::Display *display) override
+    {
+        BufferHandle *handle = OH_NativeWindow_GetBufferHandleFromNative(mBuffer);
+        if (handle == nullptr)
+        {
+            return egl::Error(EGL_BAD_PARAMETER, "No BufferHandle for the OHNativeWindowBuffer.");
+        }
+        mSize = gl::Extents(handle->width, handle->height, 1);
+        // OH_NativeBuffer_Format values.
+        switch (handle->format)
+        {
+            case 11:  // NATIVEBUFFER_PIXEL_FMT_RGBX_8888
+                mFormat = gl::Format(GL_RGB8);
+                break;
+            case 12:  // NATIVEBUFFER_PIXEL_FMT_RGBA_8888
+                mFormat = gl::Format(GL_RGBA8);
+                break;
+            case 34:  // NATIVEBUFFER_PIXEL_FMT_RGBA_1010102
+                mFormat = gl::Format(GL_RGB10_A2);
+                break;
+            case 20:  // NATIVEBUFFER_PIXEL_FMT_BGRA_8888
+                mFormat = gl::Format(GL_BGRA8_EXT);
+                break;
+            case 24:  // NATIVEBUFFER_PIXEL_FMT_YCBCR_420_SP
+            case 25:  // NATIVEBUFFER_PIXEL_FMT_YCRCB_420_SP
+            case 35:  // NATIVEBUFFER_PIXEL_FMT_YCBCR_P010
+            case 36:  // NATIVEBUFFER_PIXEL_FMT_YCRCB_P010
+                mFormat = gl::Format(GL_RGB8);
+                mYUV    = true;
+                break;
+            default:
+                return egl::Error(EGL_BAD_PARAMETER, "Unsupported OH_NativeBuffer format.");
+        }
+        return egl::NoError();
+    }
+
+    gl::Format getFormat() const override { return mFormat; }
+    bool isRenderable(const gl::Context *context) const override { return !mYUV; }
+    bool isTexturable(const gl::Context *context) const override { return true; }
+    bool isYUV() const override { return mYUV; }
+    bool hasProtectedContent() const override { return false; }
+    gl::Extents getSize() const override { return mSize; }
+    size_t getSamples() const override { return 0; }
+
+    EGLClientBuffer getBuffer() const override { return static_cast<EGLClientBuffer>(mBuffer); }
+
+  private:
+    OHNativeWindowBuffer *mBuffer;
+    gl::Extents mSize;
+    gl::Format mFormat;
+    bool mYUV = false;
+};
