+    // eglGetProcAddress hands back goes past the wrapper, does not know the
+    // display the wrapper gave out, and fails with EGL_BAD_DISPLAY -- in
+    // every process, not only where OHOS_ANGLE_WRAPPER_EXPORTS is set. So the
+    // image functions, and binding an image to a texture, always come from
+    // the wrapper's exports, the way an NDK app reaches them.
+    static const char *const kImageEntryPoints[] = {
+        "eglCreateImage", "eglCreateImageKHR", "eglDestroyImage", "eglDestroyImageKHR"};
+    for (const char *imageEntryPoint : kImageEntryPoints)
+    {
+        if (strcmp(name, imageEntryPoint) == 0)
+        {
+            if (void *exported = dlsym(nativeEGLHandle, name))
+            {
+                return exported;
+            }
+        }
+    }
+    if (strcmp(name, "glEGLImageTargetTexture2DOES") == 0 ||
