+#if BUILDFLAG(IS_OHOS)
+// Whether this GL's fences actually work, asked rather than assumed.
+//
+// The 2in1 emulator translates GLES to the host's OpenGL. It advertises
+// EGL_KHR_fence_sync, so every check Chromium already makes says fences are
+// available -- and then eglCreateSync fails, reporting EGL_SUCCESS as the
+// error, which is the tell that nothing is implemented behind it. GPU
+// rasterization goes on to read tiles that were never finished: stale tiles,
+// tiles in the wrong place, black bands down the bottom and the right, and a
+// screenshot that comes back white.
+//
+// A blocklist rule can catch a name -- and one does, for the host we have
+// seen -- but the next emulator, or the same one on a different host, has a
+// different name and the same missing fence. Making the call is the only
+// test that travels.
+bool OhosFenceSyncWorks() {
+  gl::GLDisplayEGL* display = gl::GLDisplayEGL::GetDisplayForCurrentContext();
+  if (!display) {
+    // No context to ask. Say nothing rather than something wrong.
+    return true;
+  }
+  const EGLDisplay egl_display = display->GetDisplay();
+  if (egl_display == EGL_NO_DISPLAY) {
+    return true;
+  }
+  if (!display->ext->b_EGL_KHR_fence_sync) {
+    LOG(WARNING) << "OHOS fence probe: EGL_KHR_fence_sync not advertised";
+    return false;
+  }
+
+  while (eglGetError() != EGL_SUCCESS) {
+    // Drain whatever came before, so what follows is ours.
+  }
+  const EGLSyncKHR sync =
+      eglCreateSyncKHR(egl_display, EGL_SYNC_FENCE_KHR, nullptr);
+  if (sync == EGL_NO_SYNC_KHR) {
+    LOG(WARNING) << "OHOS fence probe: eglCreateSync failed with 0x"
+                 << std::hex << eglGetError();
+    return false;
+  }
+  const EGLint waited = eglClientWaitSyncKHR(
+      egl_display, sync, EGL_SYNC_FLUSH_COMMANDS_BIT_KHR, 0);
+  const EGLint wait_error = eglGetError();
+  eglDestroySyncKHR(egl_display, sync);
+  if (waited == EGL_FALSE) {
+    LOG(WARNING) << "OHOS fence probe: eglClientWaitSync failed with 0x"
+                 << std::hex << wait_error;
+    return false;
+  }
+  LOG(WARNING) << "OHOS fence probe: fences work";
+  return true;
+}
+
+// Takes rasterization off a GPU whose fences do not, and says so where
+// chrome://gpu will show it.
+void OhosDisableGpuRasterizationWithoutFences(GpuFeatureInfo* info) {
+  if (OhosFenceSyncWorks()) {
+    return;
+  }
+  info->status_values[GPU_FEATURE_TYPE_GPU_TILE_RASTERIZATION] =
+      kGpuFeatureStatusBlocklisted;
+  LOG(WARNING) << "OHOS: GPU rasterization off, this GL has no working fence "
+                  "sync";
+}
+#endif  // BUILDFLAG(IS_OHOS)
