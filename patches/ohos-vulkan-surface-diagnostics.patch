       device_queue_->GetVulkanQueueIndex(), surface_, &present_support);
   if (result != VK_SUCCESS) {
-    DLOG(ERROR) << "vkGetPhysicalDeviceSurfaceSupportKHR() failed: " << result;
+    LOG(ERROR) << "OHOS Vulkan: vkGetPhysicalDeviceSurfaceSupportKHR() failed: " << result;
     return false;
   }
   if (!present_support) {
-    DLOG(ERROR) << "Surface not supported by present queue.";
+    LOG(ERROR) << "OHOS Vulkan: Surface not supported by present queue.";
     return false;
   }
 
