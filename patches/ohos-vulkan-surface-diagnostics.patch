+#if BUILDFLAG(IS_OHOS)
+  // The first frame only: whether anything ever reaches the window.
+  static bool reported_first_present = false;
+  if (!reported_first_present) {
+    reported_first_present = true;
+    LOG(ERROR) << "OHOS Vulkan: first present "
