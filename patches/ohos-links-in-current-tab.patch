@@ -571,6 +571,43 @@
   DCHECK(params.Valid());
 #endif
 
+#if BUILDFLAG(IS_OHOS)
+  // On a phone, a link that asks for a new tab gets the current one instead.
+  // Tabs live behind a grid there, so the new one arrives unannounced, and
+  // back does not return to the page the user came from because the new tab
+  // has no history. Navigating in place keeps both.
+  //
+  // Deliberately only here. A link with target=_blank is routed through this
+  // function, and since Chrome 88 such a link implies noopener, so nothing on
+  // the page is holding a handle to the window that would have appeared.
+  // window.open() takes another path entirely -- it needs a browsing context
+  // and goes through AddNewContents -- so a login or payment popup that reads
+  // the window it opened is untouched. That was the instruction: where it
+  // cannot be known, keep the new tab.
+  //
+  // Renderer-initiated only, so the shell's own "open in new tab", the newTab
+  // command and restoring a closed tab all still open one.
+  //
+  // TEMPORARY probe. On device the tab still opened and none of this was
+  // reached, so the routing above is in doubt; AddNewContents logs the same
+  // line. Both come out once it is known which door the click arrives at.
+  LOG(WARNING) << "OHOS link probe: OpenURLFromTab disposition="
+               << static_cast<int>(params.disposition)
+               << " rendererInitiated=" << params.is_renderer_initiated
+               << " phoneUi=" << chrome::ohos::IsAuraShellMobilePhoneUi()
+               << " url=" << params.url.possibly_invalid_spec();
+  content::OpenURLParams phone_params = params;
+  if (chrome::ohos::IsAuraShellMobilePhoneUi() && params.is_renderer_initiated &&
+      (params.disposition == WindowOpenDisposition::NEW_FOREGROUND_TAB ||
+       params.disposition == WindowOpenDisposition::NEW_BACKGROUND_TAB)) {
+    phone_params.disposition = WindowOpenDisposition::CURRENT_TAB;
+    // Straight back in with the disposition changed. The guard above is false
+    // the second time, so this goes once and no further.
+    return OpenURLFromTab(source, phone_params,
+                          std::move(navigation_handle_callback));
+  }
+#endif
+
   if ((browser_->GetType() == BrowserWindowInterface::Type::TYPE_DEVTOOLS)) {
     DevToolsWindow* window = DevToolsWindow::AsDevToolsWindow(source);
     DCHECK(window);
