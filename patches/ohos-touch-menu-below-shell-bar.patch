+                  display::Screen::Get()
+                      ->GetDisplayMatching(screen_anchor_rect)
+                      .work_area()
+                      .y();
+              screen_anchor_rect.SetByBounds(
+                  screen_anchor_rect.x(),
+                  std::min(screen_top, screen_anchor_rect.y()),
+                  screen_anchor_rect.right(), screen_anchor_rect.bottom());
+            }
+#endif  // BUILDFLAG(IS_OHOS)
             ui::TouchSelectionMenuRunner::GetInstance()->OpenMenu(
