                                          ->GetEndHandleRect()
                                          .size());
 
+            gfx::Rect screen_anchor_rect =
+                weak_this->rwhva_->ConvertRectToScreen(anchor_rect);
+#if BUILDFLAG(IS_OHOS)
+            // The menu goes above the selection unless that would leave the
+            // screen. On a phone the shell's top bar covers the top of the
+            // window, which still counts as on screen, so near the top of
+            // the page the menu opened under the address bar, half hidden.
+            // Where there is no room for it between the selection and the
+            // top of the visible page, stretch the anchor up to the top of
+            // the screen: with no room left above, the bubble goes below.
+            // The page's top is where its origin lands on screen, which
+            // includes the offset the shell's browser controls move it by.
+            constexpr int kOhosRoomForMenu = 64;
+            const int page_top =
+                weak_this->rwhva_->ConvertRectToScreen(gfx::Rect()).y();
+            if (screen_anchor_rect.y() - kOhosRoomForMenu < page_top) {
