 #include "gpu/vulkan/vulkan_device_queue.h"
@@ -128,6 +130,13 @@ bool VulkanInProcessContextProvider::Initialize(const gpu::GPUInfo* gpu_info,
   device_queue_ =
       gpu::CreateVulkanDeviceQueue(vulkan_implementation_, flags, gpu_info,
                                    heap_memory_limit_, is_thread_safe);
+#if BUILDFLAG(IS_OHOS)
+  LOG(ERROR) << "OHOS Vulkan: device queue "
+             << (device_queue_ ? "created" : "could not be created")
+             << (flags & gpu::VulkanDeviceQueue::PRESENTATION_SUPPORT_QUEUE_FLAG
+                     ? ", presentation asked for"
+                     : ", no presentation");
+#endif
   if (!device_queue_)
     return false;
 
