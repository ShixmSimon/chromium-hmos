+
+// These bubbles point at a button in Chromium's toolbar or location bar.
+// This port draws its browser UI in ArkTS: that toolbar is hidden at the top
+// of the window, under the status bar and the address bar the shell draws
+// over the page, so a bubble hanging from it had its title -- and on the save
+// password bubble its picture -- hidden behind them. Hang it from the line
+// just below the shell's top bar instead, across the window's top centre,
+// the way the page-info bubbles already are (GetPageInfoAnchorRect).
+gfx::Rect LocationBarBubbleDelegateView::GetAnchorRect() const {
+  if (BrowserWindowInterface* browser = BrowserForAnchor()) {
+    return bubble_anchor_util::GetPageInfoAnchorRect(browser);
+  }
+  return BubbleDialogDelegateView::GetAnchorRect();
+}
+#endif
