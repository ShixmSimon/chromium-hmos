 // Internal function to handle return the full or "reduced" user agent string,
 // depending on the Reduce User-Agent reduction phase features.
 #if BUILDFLAG(IS_OHOS)
+// Whether this browser is presenting itself as a phone.
+//
+// The switch is set when the shell starts in the phone UI family, so an
+// unfolded foldable is not a phone here even though its hardware class says
+// phone, and a phone with "desktop site" turned on is not one either. That is
+// what those two settings are asking for.
+bool OhosUserAgentIsPhone() {
+  return base::CommandLine::ForCurrentProcess()->HasSwitch(
+      kUseMobileUserAgent);
+}
+
