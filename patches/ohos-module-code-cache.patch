+// Opt-in experiment: prefer the existing non-streaming module cache consumer
+// only when metadata has the current V8 cache tag. This is not background
+// module deserialization; V8 and the cache handler still validate on consumption.
+BASE_FEATURE(kOhosModuleCodeCache, base::FEATURE_DISABLED_BY_DEFAULT);
+
+bool HasModuleCodeCache(mojo_base::BigBuffer& data,
+                        const TextEncoding& encoding) {
+  scoped_refptr<CachedMetadata> metadata =
+      CachedMetadata::CreateFromSerializedData(data);
+  if (!metadata) {
+    if (data.size() < sizeof(CachedMetadataHeaderWithHash)) {
+      return false;
+    }
+    const auto* header =
+        reinterpret_cast<const CachedMetadataHeaderWithHash*>(data.data());
+    if (header->marker !=
+        CachedMetadataHandler::kSingleEntryWithHashAndPadding) {
+      return false;
+    }
+    metadata = CachedMetadata::CreateFromSerializedData(
+        data, sizeof(CachedMetadataHeaderWithHash));
+    if (!metadata) {
+      return false;
+    }
+  }
+  const bool has_code_cache =
+      V8CodeCache::HasCodeCache(*metadata, encoding.GetName());
+  // CreateFromSerializedData moves the buffer. Restore it byte-for-byte,
+  // including the hash envelope; the main-thread handler must check the hash.
+  auto serialized = std::move(*metadata).DrainSerializedData();
+  CHECK(std::holds_alternative<mojo_base::BigBuffer>(serialized));
+  data = std::move(std::get<mojo_base::BigBuffer>(serialized));
+  return has_code_cache;
+}
