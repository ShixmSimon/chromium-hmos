+            true);
+}
+
+TEST_P(OhosModuleCodeCacheTest, NoMetadataKeepsStreaming) {
+  RunModule(std::nullopt, false);
+}
+
+TEST_P(OhosModuleCodeCacheTest, TimestampKeepsStreaming) {
+  RunModule(CreateDummyTimeStampData(), false);
+}
+
+TEST_P(OhosModuleCodeCacheTest, EncodingMismatchKeepsStreaming) {
+  RunModule(CreateDummyCodeCacheData(), false, "windows-1252");
+}
+
+TEST_P(OhosModuleCodeCacheTest, TruncatedMetadataKeepsStreaming) {
+  const uint8_t invalid[] = {0, 0};
+  RunModule(mojo_base::BigBuffer(base::span(invalid)), false);
+}
+
+TEST_P(OhosModuleCodeCacheTest, TruncatedHashEnvelopeKeepsStreaming) {
+  auto metadata = CreateDummyCodeCacheDataWithHash(
