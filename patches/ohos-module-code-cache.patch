+// Exercise the complete background response handoff with the experiment both
+// enabled and disabled. Keep the background decoder enabled to catch accidental
+// use of kHasCodeCacheBackground with a null Result.
+class OhosModuleCodeCacheTest
+    : public BackgroundResourceScriptStreamerTestBase,
+      public testing::WithParamInterface<bool> {
+ public:
+  OhosModuleCodeCacheTest() {
+    const std::string background =
+        "BackgroundResourceFetch:background-script-response-processor/true/"
+        "background-code-cache-decoder-start/true";
+    feature_list_.InitFromCommandLine(
+        background + (GetParam() ? ",OhosModuleCodeCache" : ""),
+        GetParam() ? "" : "OhosModuleCodeCache");
+  }
+
+ protected:
+  void RunModule(std::optional<mojo_base::BigBuffer> metadata,
+                 bool has_code_cache,
+                 const std::string& charset = "utf-8") {
+    V8TestingScope scope;
+    Init(scope.GetIsolate(), /*is_module_script=*/true);
+    std::optional<std::vector<uint8_t>> original;
+    if (metadata) {
+      original.emplace(metadata->begin(), metadata->end());
+    }
+    const bool prefer_cache = GetParam() && has_code_cache;
+    RunInBackgroundThread(base::BindLambdaForTesting([&]() {
+      auto head = CreateURLResponseHead();
+      head->charset = charset;
+      EXPECT_EQ(!prefer_cache,
+                background_response_processor_->MaybeStartProcessingResponse(
+                    head, consumer_handle_, metadata,
+                    background_resource_fetch_task_runner_,
+                    &background_response_processor_client_));
+      EXPECT_EQ(prefer_cache, !!head);
+      EXPECT_EQ(prefer_cache, !!consumer_handle_);
+      if (prefer_cache) {
+        ASSERT_TRUE(metadata);
+        EXPECT_THAT(*metadata, testing::ElementsAreArray(*original));
+      }
+    }));
+    AppendData(kLargeEnoughScript);
+    producer_handle_.reset();
+    if (!prefer_cache) {
+      background_response_processor_client_.WaitUntilFinished();
+      std::optional<base::span<const uint8_t>> expected;
+      if (original) {
+        expected = base::span<const uint8_t>(*original);
+      }
+      background_response_processor_client_.CheckResultOfFinishCallback(
+          base::span_from_cstring(kLargeEnoughScript), expected);
+    }
+    Finish();
+    RunUntilResourceLoaded();
+    if (prefer_cache) {
+      CheckNotStreamingReason(ScriptStreamer::NotStreamingReason::kHasCodeCache,
+                              mojom::blink::ScriptType::kModule);
+    } else {
+      EXPECT_TRUE(TakeScriptStreamer(mojom::blink::ScriptType::kModule));
+    }
+  }
+};
+
+INSTANTIATE_TEST_SUITE_P(All, OhosModuleCodeCacheTest, testing::Bool());
+
+TEST_P(OhosModuleCodeCacheTest, TaggedCachePreservesOwnership) {
