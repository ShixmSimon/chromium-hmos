+}
+
+TEST_P(OhosModuleCodeCacheTest, HashEnvelopePreservedForValidation) {
+  RunModule(CreateDummyCodeCacheDataWithHash(
+                base::span_from_cstring(kLargeEnoughScript)),
+            true);
+}
+
+TEST_P(OhosModuleCodeCacheTest, DifferentHashStillRequiresConsumerValidation) {
+  // Selecting this path is not cache acceptance. Preserve the mismatched hash
