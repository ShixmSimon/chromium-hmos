+      if (orientation_ == TouchHandleOrientation::CENTER) {
+        const gfx::RectF caret(focus_top_.x() - touch_radius, focus_top_.y(),
+                               2 * touch_radius,
+                               focus_bottom_.y() - focus_top_.y());
+        on_caret = caret.Contains(touch_point);
+      }
+#endif
       // Only use the touch radius for targeting if the touch is at or below
