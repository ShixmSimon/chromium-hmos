       // text above the drawable.
-      if (touch_point.y() < drawable_bounds.y() ||
-          !RectIntersectsCircle(drawable_bounds, touch_point, touch_radius)) {
+      if (!on_caret &&
+          (touch_point.y() < drawable_bounds.y() ||
+           !RectIntersectsCircle(drawable_bounds, touch_point,
