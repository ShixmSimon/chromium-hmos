+int BrowserWebContentsDelegate::GetBottomControlsHeight() {
+#if BUILDFLAG(IS_OHOS)
+  // A phone's dock, the shell's bar along the bottom: it slides away with
+  // the top bar as the page scrolls, and the page grows into the room.
+  return chrome::ohos::GetAuraShellBottomControlsHeight();
+#else
+  return content::WebContentsDelegate::GetBottomControlsHeight();
+#endif
+}
+
 bool BrowserWebContentsDelegate::DoBrowserControlsShrinkRendererSize(
     content::WebContents* contents) {
+#if BUILDFLAG(IS_OHOS)
+  // Room is made for the shell's bar rather than the page drawing under it
+  // at the top: shrink the viewport while the controls are shown.
+  if (chrome::ohos::GetAuraShellTopControlsHeight() > 0 ||
+      chrome::ohos::GetAuraShellBottomControlsHeight() > 0) {
+    return true;
+  }
+#endif
   return window_->DoBrowserControlsShrinkRendererSize(contents);
 }
 
