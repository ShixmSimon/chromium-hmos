+#if BUILDFLAG(IS_OHOS)
+namespace {
+
+// How much of the main frame's height, in device pixels, the page does not
+// lay out in while the shell's browser controls are shown.
+//
+// The compositor assumes, as on Android, that a renderer whose controls
+// shrink it was given the size it has with the controls shown, and grows
+// the viewport by what the controls hide as they slide away. Aura gave it
+// the whole window instead: the layout viewport never lost the controls'
+// height, so with a top bar and a dock showing the end of the page sat
+// behind the dock, and a page just short enough to fit the window scrolled
+// and hid them. Take the controls off, as Android's view already is.
+//
+// With bottom controls -- a phone whose dock hides -- the insets are what
+// stays covered however the page scrolls, the gesture bar; they come off
+// the layout too, so the end of the page stops above it without relying
+// on the visual viewport panning past the layout one.
+struct OhosReservedHeight {
+  int controls_px = 0;
+  bool has_bottom_controls = false;
+};
+
+OhosReservedHeight GetOhosReservedHeight(RenderWidgetHostImpl* host) {
+  // Only the main frame's widget: a <select> popup or other widget of its
+  // own is sized to what it shows.
+  if (!host || !host->owner_delegate() || !host->delegate()) {
+    return {};
+  }
+  RenderViewHostDelegateView* view = host->delegate()->GetDelegateView();
+  if (!view || !view->DoBrowserControlsShrinkRendererSize()) {
+    return {};
+  }
+  const int bottom = view->GetBottomControlsHeight();
+  return {view->GetTopControlsHeight() + bottom, bottom > 0};
+}
+
+}  // namespace
+
+gfx::Size RenderWidgetHostViewAura::GetRequestedRendererSizeDevicePx() {
+  gfx::Size size = gfx::ScaleToCeiledSize(
+      RenderWidgetHostViewBase::GetRequestedRendererSize(),
+      GetDeviceScaleFactor());
+  const OhosReservedHeight reserved = GetOhosReservedHeight(host());
+  int reserved_px = reserved.controls_px;
+  if (reserved.has_bottom_controls) {
+    reserved_px += static_cast<int>(
+        std::ceil(insets_.bottom() * GetDeviceScaleFactor()));
+  }
+  if (reserved_px > 0) {
+    // Once per change, so the numbers can be checked against the page's
+    // innerHeight and visualViewport.height on a device.
+    static int logged_height = -1;
+    static int logged_reserved = -1;
+    if (logged_height != size.height() || logged_reserved != reserved_px) {
+      logged_height = size.height();
+      logged_reserved = reserved_px;
+      LOG(WARNING) << "OHOS browser controls: renderer gets "
+                   << size.height() - reserved_px << "px of a "
+                   << size.height() << "px window; controls "
+                   << reserved.controls_px << "px, kept covered "
+                   << reserved_px - reserved.controls_px << "px";
+    }
+  }
+  size.set_height(std::max(0, size.height() - reserved_px));
+  return size;
+}
+
+// The whole window: the compositor draws into all of it, including what the
+// controls leave as they slide away. Only the layout size loses them.
+gfx::Size RenderWidgetHostViewAura::GetCompositorViewportPixelSize() {
+  return gfx::ScaleToCeiledSize(
+      RenderWidgetHostViewBase::GetRequestedRendererSize(),
+      GetDeviceScaleFactor());
+}
+
+gfx::Size RenderWidgetHostViewAura::GetRequestedRendererSize() {
+  const float scale = GetDeviceScaleFactor();
+  return scale > 0.0f ? gfx::ScaleToCeiledSize(
+                            GetRequestedRendererSizeDevicePx(), 1.0f / scale)
+                      : RenderWidgetHostViewBase::GetRequestedRendererSize();
+}
+#endif
+
 gfx::Size RenderWidgetHostViewAura::GetVisibleViewportSize() {
   gfx::Rect requested_rect(GetRequestedRendererSize());
+#if BUILDFLAG(IS_OHOS)
+  // The insets are already off the requested size; see above.
+  if (GetOhosReservedHeight(host()).has_bottom_controls) {
+    return requested_rect.size();
+  }
+#endif
   requested_rect.Inset(insets_);
   return requested_rect.size();
 }
 
 gfx::Size RenderWidgetHostViewAura::GetVisibleViewportSizeDevicePx() {
   gfx::Rect requested_rect(GetRequestedRendererSizeDevicePx());
+#if BUILDFLAG(IS_OHOS)
+  if (GetOhosReservedHeight(host()).has_bottom_controls) {
+    return requested_rect.size();
+  }
+#endif
   auto scaled_insets = ScaleToCeiledInsets(insets_, GetDeviceScaleFactor());
   requested_rect.Inset(scaled_insets);
   return requested_rect.size();
