                                                     ui::Event* event) {
   Window* window = static_cast<Window*>(root);
-  return event->IsKeyEvent() ? FindTargetForKeyEvent(window)
-                             : FindTargetForNonKeyEvent(window, event);
+  ui::EventTarget* const target =
+      event->IsKeyEvent() ? FindTargetForKeyEvent(window)
+                          : FindTargetForNonKeyEvent(window, event);
+#if BUILDFLAG(IS_OHOS)
+  // Which aura window a press actually resolved to. Presses only, so this is
+  // one line per tap rather than one per move.
+  if (event->type() == ui::EventType::kTouchPressed ||
+      event->type() == ui::EventType::kMousePressed) {
+    Window* const target_window = static_cast<Window*>(target);
+    LOG(WARNING) << "OHOS aura target root=" << window->GetName()
+                 << " location="
+                 << (event->IsLocatedEvent()
+                         ? event->AsLocatedEvent()->root_location().ToString()
+                         : std::string("-"))
+                 << " target="
+                 << (target_window ? target_window->GetName()
+                                   : std::string("(none)"))
+                 << " target_bounds="
+                 << (target_window
+                         ? target_window->GetBoundsInScreen().ToString()
+                         : std::string("-"));
+  }
+#endif
+  return target;
 }
 
