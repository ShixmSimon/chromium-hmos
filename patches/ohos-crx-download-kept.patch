Leave a downloaded .crx for the shell, and never delete it.

A .crx from a site other than the web store is downloaded, not installed
-- upstream's rule. But when the download finished, Chromium tried to
install it anyway, with the web store's check: CRX3 with a publisher
proof. A package from the Edge store or one packed by hand has no such
proof, so it failed with CRX_REQUIRED_PROOF_MISSING -- and the installer
was told to delete its source, so the reader's download went with it.
The shell's "Install" (installExtensionFromFile, which checks CRX3
without the proof, behind Chromium's own confirmation) then found no
file.

With the shell drawing the browser, a finished .crx is now left alone:
the shell tells the reader and installs on their say. And on OHOS the
download's installer never deletes the file, in either UI: a failed
install is no reason for someone's download to disappear.

Generated for Chromium 154.0.8037.51 after ohos-save-as-no-prompt.patch.

diff --git a/chrome/browser/download/chrome_download_manager_delegate.cc b/chrome/browser/download/chrome_download_manager_delegate.cc
--- a/chrome/browser/download/chrome_download_manager_delegate.cc
+++ b/chrome/browser/download/chrome_download_manager_delegate.cc
@@ -35,6 +35,9 @@
 #include "chrome/browser/download/download_core_service.h"
 #include "chrome/browser/download/download_core_service_factory.h"
 #include "chrome/browser/download/download_crx_util.h"
+#if BUILDFLAG(IS_OHOS)
+#include "chrome/browser/ui/ohos/aura_shell_runtime_bridge.h"  // nogncheck
+#endif
 #include "chrome/browser/download/download_dialog_types.h"
 #include "chrome/browser/download/download_file_picker.h"
 #include "chrome/browser/download/download_history.h"
@@ -1132,6 +1135,18 @@ bool ChromeDownloadManagerDelegate::ShouldOpenDownload(
     DownloadItem* item,
     content::DownloadOpenDelayedCallback callback) {
 #if BUILDFLAG(ENABLE_EXTENSIONS_CORE)
+#if BUILDFLAG(IS_OHOS)
+  // With the shell drawing the browser, a finished .crx is the shell's to
+  // offer: it tells the reader and installs on their say
+  // (installExtensionFromFile). Installing it here, as upstream does, ran
+  // the web store's check on a file from another site, failed it, and --
+  // with delete_source set -- deleted the reader's download, so the
+  // shell's "Install" then found no file.
+  if (chrome::ohos::IsAuraShellChromeHiddenByShell() &&
+      extensions::util::IsExtensionDownload(*item)) {
+    return true;
+  }
+#endif
   if (extensions::util::IsExtensionDownload(*item) &&
       !extensions::WebstoreInstaller::GetAssociatedApproval(*item) &&
       !profile_->IsOffTheRecord()) {
diff --git a/chrome/browser/download/download_crx_util.cc b/chrome/browser/download/download_crx_util.cc
--- a/chrome/browser/download/download_crx_util.cc
+++ b/chrome/browser/download/download_crx_util.cc
@@ -111,7 +111,13 @@ scoped_refptr<extensions::CrxInstaller> CreateCrxInstaller(
           WebstoreInstaller::GetAssociatedApproval(download_item)));
 
   installer->set_error_on_unsupported_requirements(true);
+#if BUILDFLAG(IS_OHOS)
+  // The file is the reader's download, in their Download folder. A failed
+  // install is no reason for it to disappear.
+  installer->set_delete_source(false);
+#else
   installer->set_delete_source(true);
+#endif
   installer->set_was_triggered_by_user_download();
   installer->set_original_mime_type(download_item.GetOriginalMimeType());
   installer->set_apps_require_extension_mime_type(true);
