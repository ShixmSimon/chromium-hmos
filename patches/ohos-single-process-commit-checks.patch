--- a/content/browser/security/cpsp/child_process_security_policy_impl.cc
+++ b/content/browser/security/cpsp/child_process_security_policy_impl.cc
@@ -1992,6 +1992,20 @@ bool ChildProcessSecurityPolicyImpl::CanCommitURL(int child_id,
     return true;
   }
 
+#if BUILDFLAG(IS_OHOS)
+  // A phone runs Chromium single-process: the browser, every page, every
+  // WebUI and every extension share the one process, because the platform
+  // lets an app start no other. A process lock or a grant can only say what
+  // that process may commit, and there is nothing it may not -- it is the
+  // browser. The checks below were refusing chrome-extension:// pages,
+  // which in single-process mode is a browser kill (see
