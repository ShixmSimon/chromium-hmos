-  // and arrives here as NEW_POPUP; it keeps its own window, because a page
-  // that asked for one is usually a login or a payment that is watching it.
+  // Only for a new tab -- which on a phone a popup has become above. Elsewhere
+  // a popup keeps its own window.
   if (!params.group &&
       (disposition == WindowOpenDisposition::NEW_FOREGROUND_TAB ||
        disposition == WindowOpenDisposition::NEW_BACKGROUND_TAB)) {
