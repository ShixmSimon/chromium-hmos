@@ -38,6 +38,11 @@
 #include "base/time/time.h"
 #include "base/timer/timer.h"
 #include "build/build_config.h"
+
+#if BUILDFLAG(IS_OHOS)
+#include "base/file_descriptor_store.h"
+#include "base/process/launch_ohos.h"
+#endif
 #include "chrome/common/buildflags.h"
 #include "chrome/common/channel_info.h"
 #include "chrome/common/chrome_constants.h"
@@ -680,6 +685,13 @@ void InitLogging(const std::string& process_type) {
   }
   const base::CommandLine& command_line =
       *base::CommandLine::ForCurrentProcess();
+#if BUILDFLAG(IS_OHOS)
+  if (base::internal::IsOhosIsolatedRenderer()) {
+    // The native entry has already installed hilog forwarding. Do not open
+    // a log under the browser profile from an isolated UID.
+    return;
+  }
+#endif
   logging::InitChromeLogging(command_line, file_state);
 
 #if BUILDFLAG(IS_CHROMEOS)
@@ -1572,14 +1584,40 @@ void ChromeMainDelegate::PreSandboxStartup() {
     base::i18n::SetICUDefaultLocale(locale);
     const std::string loaded_locale = locale;
 #else
-    const std::string loaded_locale =
-        ui::ResourceBundle::InitSharedInstanceWithLocale(
-            locale, nullptr, ui::ResourceBundle::LOAD_COMMON_RESOURCES);
-
-    base::FilePath resources_pack_path;
-    base::PathService::Get(chrome::FILE_RESOURCES_PACK, &resources_pack_path);
-    ui::ResourceBundle::GetSharedInstance().AddDataPackFromPath(
-        resources_pack_path, ui::kScaleFactorNone);
+    std::string loaded_locale;
+#if BUILDFLAG(IS_OHOS)
+    if (base::internal::IsOhosIsolatedRenderer()) {
+      auto& store = base::FileDescriptorStore::GetInstance();
+      base::MemoryMappedFile::Region region;
+      auto locale_fd = store.TakeFD(base::internal::kOhosLocalePak, &region);
+      ui::ResourceBundle::InitSharedInstanceWithPakFileRegion(
+          base::File(std::move(locale_fd)), region);
+      const struct {
+        const char* name;
+        ui::ResourceScaleFactor scale;
+      } packs[] = {
+          {base::internal::kOhosChrome100Pak, ui::k100Percent},
+          {base::internal::kOhosChrome200Pak, ui::k200Percent},
+          {base::internal::kOhosResourcesPak, ui::kScaleFactorNone},
+      };
+      for (const auto& pack : packs) {
+        auto fd = store.TakeFD(pack.name, &region);
+        ui::ResourceBundle::GetSharedInstance().AddDataPackFromFileRegion(
+            base::File(std::move(fd)), region, pack.scale);
+      }
+      base::i18n::SetICUDefaultLocale(locale);
+      loaded_locale = locale;
+      LOG(WARNING) << "OHOS child startup resource bundle ready";
+    } else
+#endif
+    {
+      loaded_locale = ui::ResourceBundle::InitSharedInstanceWithLocale(
+          locale, nullptr, ui::ResourceBundle::LOAD_COMMON_RESOURCES);
+      base::FilePath resources_pack_path;
+      base::PathService::Get(chrome::FILE_RESOURCES_PACK, &resources_pack_path);
+      ui::ResourceBundle::GetSharedInstance().AddDataPackFromPath(
+          resources_pack_path, ui::kScaleFactorNone);
+    }
 #endif  // BUILDFLAG(IS_ANDROID)
     CHECK(!loaded_locale.empty()) << "Locale could not be found for " << locale;
   }
