+  // target changed under the finger.
+  if (target_rwh == current_rwh_for_drag_.get() && current_drag_data_) {
+    auto dropped = std::make_unique<DropData>();
+    PrepareDropData(dropped.get(), *data.get());
+    dropped->operation = current_drag_data_->operation;
+    dropped->document_is_handling_drag =
+        current_drag_data_->document_is_handling_drag;
+    current_rwh_for_drag_->FilterDropData(dropped.get());
+    current_drag_data_ = std::move(dropped);
+  }
+#endif
   if (target_rwh != current_rwh_for_drag_.get()) {
     if (current_rwh_for_drag_)
       current_rwh_for_drag_->DragTargetDragLeave(transformed_pt.value(),
@@ -1804,6 +1831,10 @@ void WebContentsViewAura::PerformDropCallback(
     return;
   }
 
+#if BUILDFLAG(IS_OHOS)
+  last_drop_data_ = std::make_unique<DropData>(*current_drag_data_);
+#endif
+
   OnPerformingDropContext drop_context(
       target_rwh, std::move(current_drag_data_), drop_metadata, std::move(data),
       std::move(drop_exit_cleanup), transformed_pt, screen_pt);
