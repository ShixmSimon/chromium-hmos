@@ -1785,6 +1795,23 @@ void WebContentsViewAura::PerformDropCallback(
   CHECK(transformed_pt.has_value(), base::NotFatalUntil::M158);
 
   gfx::PointF screen_pt(display::Screen::Get()->GetCursorScreenPoint());
+#if BUILDFLAG(IS_OHOS)
+  // HarmonyOS says only which types are coming while the finger is down, so
+  // the data kept since enter holds a placeholder for each file. What comes
+  // with the drop is the first sight of the real thing, and it is what the
+  // page has to get: the files' names and paths, which a page never sees
