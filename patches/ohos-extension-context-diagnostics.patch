Say why a web page was refused an extension API.

The Chrome Web Store greys out "Add to Chrome" because its calls to
chrome.webstorePrivate come back "Invalid context type provided.", which
ExtensionFunctionDispatcher emits when ProcessMap::CanProcessHostContextType
returns false. For a web page that verdict is three predicates ANDed
together and nothing outside says which one failed.

The suspicion is that none of them can hold on a phone, because a phone runs
--single-process: one process hosts the browser, every page, the WebUI the
new tab page is built from, and any extension, so "this process also hosts a
WebUI" is permanently true and every web page's API call is refused. If that
is the reason then a tablet and a PC, which run separate renderer processes,
are unaffected -- but nobody here has a tablet or a PC to check on, and if
the reason is something else they would be just as broken. Hence a log line
rather than a change: it names the failing predicate and says whether the
process is shared, which settles both questions in one reproduction.

Diagnostic only. Nothing is allowed that was not allowed before.

diff --git a/extensions/browser/process_map.cc b/extensions/browser/process_map.cc
--- a/extensions/browser/process_map.cc
+++ b/extensions/browser/process_map.cc
@@ -10,6 +10,7 @@
 #include <tuple>

 #include "base/containers/map_util.h"
+#include "base/logging.h"
 #include "base/types/optional_util.h"
 #include "components/guest_view/buildflags/buildflags.h"
 #include "content/public/browser/child_process_security_policy.h"
@@ -181,8 +182,20 @@
       // Any context not associated with an extension, not running in an
       // extension process, and without webui bindings can be considered a
       // web page process.
-      return !extension && !Contains(process_id) &&
-             !ProcessHasWebUIBindings(process_id);
+      {
+        const bool in_extension_process = Contains(process_id);
+        const bool has_webui_bindings = ProcessHasWebUIBindings(process_id);
+        const bool allowed =
+            !extension && !in_extension_process && !has_webui_bindings;
+        LOG(WARNING) << "OHOS extension context: allowed=" << allowed
+                     << " extension=" << (extension ? extension->id() : "none")
+                     << " in_extension_process=" << in_extension_process
+                     << " has_webui_bindings=" << has_webui_bindings
+                     << " single_process="
+                     << content::RenderProcessHost::run_renderer_in_process()
+                     << " process_id=" << process_id.GetUnsafeValue();
+        return allowed;
+      }
     case mojom::ContextType::kWebUi:
       // Don't consider extensions in webui (like content scripts) to be
       // webui.
