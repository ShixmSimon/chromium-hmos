+  for (const GURL& url : configurator_impl_.UpdateUrl()) {
+    if (url.SchemeIs("https")) urls.push_back(url);
+  }
+  return urls;
+#else
   return configurator_impl_.UpdateUrl();
+#endif
 }
 
