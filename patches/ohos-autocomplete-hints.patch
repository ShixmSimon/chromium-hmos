+#if BUILDFLAG(IS_OHOS)
+  // HarmonyOS keyboards and Password Vault act on what a field is for -- a
+  // user name, a password being chosen, a one-time code -- which the web says
+  // with autocomplete tokens and no TextInputType carries. Pass the three the
+  // platform distinguishes as bits well above the shared flags; they travel
+  // with the flags as an int and only the OHOS input method reads them
+  // (ui/ozone/platform/ohos/ohos_input_method.cc, same values).
+  constexpr int kOhosAutocompleteUsername = 1 << 24;
+  constexpr int kOhosAutocompleteNewPassword = 1 << 25;
+  constexpr int kOhosAutocompleteOneTimeCode = 1 << 26;
+  if (const AtomicString& autocomplete =
+          element->FastGetAttribute(html_names::kAutocompleteAttr)) {
+    for (const String& token : autocomplete.GetString().Split(' ')) {
+      if (EqualIgnoringAsciiCase(token, "username")) {
+        flags |= kOhosAutocompleteUsername;
+      } else if (EqualIgnoringAsciiCase(token, "new-password")) {
+        flags |= kOhosAutocompleteNewPassword;
+      } else if (EqualIgnoringAsciiCase(token, "one-time-code")) {
+        flags |= kOhosAutocompleteOneTimeCode;
+      }
+    }
+  }
+#endif
