+void DeleteCachedOhosThemeFontData() {
+  const base::FilePath cache_path = GetOhosThemeFontCachePath();
+  if (!cache_path.empty()) {
+    base::DeleteFile(cache_path);
+  }
+}
+
+bool WriteCachedOhosThemeFontData(std::string_view font_id,
+                                  const std::vector<sk_sp<SkData>>& fonts) {
+  const base::FilePath cache_path = GetOhosThemeFontCachePath();
+  if (cache_path.empty() || fonts.empty() ||
+      fonts.size() > kMaxThemeFontFiles ||
+      !base::CreateDirectory(cache_path.DirName())) {
+    return false;
+  }
+
+  size_t total_size = 0;
+  for (const sk_sp<SkData>& font : fonts) {
+    if (!font || font->isEmpty() || font->size() > kMaxThemeFontFileSize ||
+        total_size > kMaxThemeFontCacheSize - font->size()) {
+      return false;
+    }
+    total_size += font->size();
+  }
+
+  base::Pickle cache;
+  cache.WriteUInt32(kOhosThemeCacheMagic);
+  cache.WriteUInt32(kOhosThemeCacheVersion);
+  cache.WriteString(font_id);
+  cache.WriteUInt32(static_cast<uint32_t>(fonts.size()));
+  for (const sk_sp<SkData>& font : fonts) {
+    cache.WriteData(static_cast<const char*>(font->data()), font->size());
+  }
+
+  const base::FilePath temporary_path = cache_path.AddExtensionASCII("tmp");
+  if (!base::WriteFile(temporary_path, cache.AsBytes()) ||
+      !base::ReplaceFile(temporary_path, cache_path, nullptr)) {
+    base::DeleteFile(temporary_path);
+    return false;
+  }
+  return true;
+}
+
+std::vector<sk_sp<SkData>> ReadCachedOhosThemeFontData(
+    std::optional<std::string_view> expected_font_id) {
+  std::vector<sk_sp<SkData>> fonts;
+  const base::FilePath cache_path = GetOhosThemeFontCachePath();
+  std::string cache_bytes;
+  if (cache_path.empty() || !base::ReadFileToString(cache_path, &cache_bytes) ||
+      cache_bytes.size() > kMaxThemeFontCacheSize) {
+    return fonts;
+  }
+
+  const base::Pickle cache =
+      base::Pickle::WithData(base::as_byte_span(cache_bytes));
+  base::PickleIterator iterator(cache);
+  uint32_t magic = 0;
+  uint32_t version = 0;
+  uint32_t count = 0;
+  std::string cached_font_id;
+  if (!iterator.ReadUInt32(&magic) || magic != kOhosThemeCacheMagic ||
+      !iterator.ReadUInt32(&version) || version != kOhosThemeCacheVersion ||
+      !iterator.ReadString(&cached_font_id) ||
+      (expected_font_id && cached_font_id != *expected_font_id) ||
+      !iterator.ReadUInt32(&count) || count == 0 ||
+      count > kMaxThemeFontFiles) {
+    return fonts;
+  }
+
+  size_t total_size = 0;
+  for (uint32_t index = 0; index < count; ++index) {
+    std::optional<base::span<const uint8_t>> data = iterator.ReadData();
+    if (!data || data->empty() || data->size() > kMaxThemeFontFileSize ||
+        total_size > kMaxThemeFontCacheSize - data->size()) {
+      return {};
+    }
+    total_size += data->size();
+    AppendUniqueThemeFontData(SkData::MakeWithCopy(data->data(), data->size()),
+                              &fonts);
+  }
+  if (!iterator.ReachedEnd() || fonts.empty()) {
+    return {};
+  }
+  return fonts;
+}
+
+bool IsSansGenericFamily(const char* family) {
+  if (!family || !family[0]) {
+    return true;
+  }
+  const std::string_view name(family);
+  return name == "sans" || name == "sans-serif" || name == "system-ui" ||
+         name == kHarmonyOsSansFamily || name.starts_with("Roboto") ||
+         name.starts_with("Google Sans") || name.starts_with("GoogleSans");
+}
+
+bool HasFontStyles(const sk_sp<SkFontStyleSet>& styles) {
+  return styles && styles->count() > 0;
+}
+
+class OhosFontManager final : public SkFontMgr {
+ public:
+  OhosFontManager(sk_sp<SkFontMgr> theme, sk_sp<SkFontMgr> system)
+      : theme_(std::move(theme)), system_(std::move(system)) {}
+
+ private:
+  int onCountFamilies() const override {
+    return theme_->countFamilies() + system_->countFamilies();
+  }
+
+  void onGetFamilyName(int index, SkString* family_name) const override {
+    const int theme_count = theme_->countFamilies();
+    if (index < theme_count) {
+      theme_->getFamilyName(index, family_name);
+      return;
+    }
+    system_->getFamilyName(index - theme_count, family_name);
+  }
+
+  sk_sp<SkFontStyleSet> onCreateStyleSet(int index) const override {
+    const int theme_count = theme_->countFamilies();
+    return index < theme_count ? theme_->createStyleSet(index)
+                               : system_->createStyleSet(index - theme_count);
+  }
+
+  sk_sp<SkFontStyleSet> onMatchFamily(const char family[]) const override {
+    if (IsSansGenericFamily(family)) {
+      sk_sp<SkFontStyleSet> theme_styles = theme_->matchFamily(nullptr);
+      if (HasFontStyles(theme_styles)) {
+        return theme_styles;
+      }
+    } else {
+      sk_sp<SkFontStyleSet> theme_styles = theme_->matchFamily(family);
+      if (HasFontStyles(theme_styles)) {
+        return theme_styles;
+      }
+    }
+    return system_->matchFamily(family);
+  }
+
+  sk_sp<SkTypeface> onMatchFamilyStyle(
+      const char family[],
+      const SkFontStyle& style) const override {
+    if (IsSansGenericFamily(family)) {
+      if (sk_sp<SkTypeface> typeface =
+              theme_->matchFamilyStyle(nullptr, style)) {
+        return typeface;
+      }
+    } else if (HasFontStyles(theme_->matchFamily(family))) {
+      if (sk_sp<SkTypeface> typeface =
+              theme_->matchFamilyStyle(family, style)) {
+        return typeface;
+      }
+    }
+    return system_->matchFamilyStyle(family, style);
+  }
+
+  sk_sp<SkTypeface> onMatchFamilyStyleCharacter(
+      const char family[],
+      const SkFontStyle& style,
+      const char* bcp47[],
+      int bcp47_count,
+      SkUnichar character) const override {
+    if (!IsSansGenericFamily(family)) {
+      if (HasFontStyles(theme_->matchFamily(family))) {
+        sk_sp<SkTypeface> typeface = theme_->matchFamilyStyle(family, style);
+        if (typeface && typeface->unicharToGlyph(character)) {
+          return typeface;
+        }
+      }
+      sk_sp<SkTypeface> system_typeface = system_->matchFamilyStyleCharacter(
+          family, style, bcp47, bcp47_count, character);
+      if (system_typeface) {
+        return system_typeface;
+      }
+    }
+
+    if (sk_sp<SkTypeface> theme_typeface = theme_->matchFamilyStyleCharacter(
+            nullptr, style, bcp47, bcp47_count, character)) {
+      return theme_typeface;
+    }
+    return system_->matchFamilyStyleCharacter(family, style, bcp47, bcp47_count,
+                                              character);
+  }
+
+  sk_sp<SkTypeface> onMakeFromData(sk_sp<SkData> data,
+                                   int ttc_index) const override {
+    return system_->makeFromData(std::move(data), ttc_index);
+  }
+
+  sk_sp<SkTypeface> onMakeFromStreamIndex(std::unique_ptr<SkStreamAsset> stream,
+                                          int ttc_index) const override {
+    return system_->makeFromStream(std::move(stream), ttc_index);
+  }
+
+  sk_sp<SkTypeface> onMakeFromStreamArgs(
+      std::unique_ptr<SkStreamAsset> stream,
+      const SkFontArguments& arguments) const override {
+    return system_->makeFromStream(std::move(stream), arguments);
+  }
+
+  sk_sp<SkTypeface> onMakeFromFile(const char path[],
+                                   int ttc_index) const override {
+    return system_->makeFromFile(path, ttc_index);
+  }
+
+  sk_sp<SkTypeface> onLegacyMakeTypeface(const char family[],
+                                         SkFontStyle style) const override {
+    if (IsSansGenericFamily(family)) {
+      if (sk_sp<SkTypeface> typeface =
+              theme_->legacyMakeTypeface(nullptr, style)) {
+        return typeface;
+      }
+    } else if (HasFontStyles(theme_->matchFamily(family))) {
+      if (sk_sp<SkTypeface> typeface =
+              theme_->legacyMakeTypeface(family, style)) {
+        return typeface;
+      }
+    }
+    return system_->legacyMakeTypeface(family, style);
+  }
+
+  const sk_sp<SkFontMgr> theme_;
+  const sk_sp<SkFontMgr> system_;
+};
+
+sk_sp<SkFontMgr> MakeOhosFontManager(
+    std::optional<std::string_view> expected_font_id = std::nullopt) {
+  RefreshOhosNativeThemeFontCache();
+  OhosFontConfiguration config = ReadOhosFontConfiguration();
+  if (config.directories.empty()) {
+    config.directories.emplace_back("/system/fonts");
+  }
+
+  std::vector<const char*> directories;
+  directories.reserve(config.directories.size());
+  for (const std::string& directory : config.directories) {
+    directories.push_back(directory.c_str());
+  }
+  sk_sp<SkFontMgr> system_manager = SkFontMgr_New_Custom_Directories(
+      directories.data(), static_cast<int>(directories.size()),
+      kHarmonyOsSansFamily);
+
+  std::string theme_source = "none";
+  bool native_theme_bridge_available = false;
+  std::vector<sk_sp<SkData>> theme_fonts;
+  bool is_browser_process = true;
+  if (base::CommandLine::InitializedForCurrentProcess()) {
+    is_browser_process = base::CommandLine::ForCurrentProcess()
+                             ->GetSwitchValueASCII("type")
+                             .empty();
+  }
+  if (is_browser_process) {
+    theme_fonts = ReadOhosNativeThemeFontData(&native_theme_bridge_available);
+  }
+  if (!theme_fonts.empty()) {
+    theme_source = "native-font-collection";
+    WriteCachedOhosThemeFontData(expected_font_id.value_or(""), theme_fonts);
+  } else if (native_theme_bridge_available) {
+    DeleteCachedOhosThemeFontData();
+  } else {
+    theme_fonts = ReadCachedOhosThemeFontData(expected_font_id);
+    if (!theme_fonts.empty()) {
+      theme_source = "renderer-cache";
+    }
+  }
+
+  sk_sp<SkFontMgr> manager = system_manager;
+  if (!theme_fonts.empty()) {
+    sk_sp<SkFontMgr> theme_manager = SkFontMgr_New_Custom_Data(
+        SkSpan<sk_sp<SkData>>(theme_fonts.data(), theme_fonts.size()));
+    if (theme_manager && theme_manager->countFamilies() > 0) {
+      manager = sk_make_sp<OhosFontManager>(std::move(theme_manager),
+                                            std::move(system_manager));
+    }
+  }
+
+  SkString resolved_family;
+  if (manager) {
+    sk_sp<SkTypeface> resolved =
+        manager->legacyMakeTypeface(nullptr, SkFontStyle());
+    if (resolved) {
+      resolved->getFamilyName(&resolved_family);
+    }
+  }
+  LOG(INFO) << "OHOS system font: requested="
+            << (theme_fonts.empty() ? kHarmonyOsSansFamily : kOhosThemeFamily)
+            << " resolved="
+            << (resolved_family.isEmpty() ? "<none>" : resolved_family.c_str())
+            << " directories=" << directories.size()
+            << " themeFont=" << theme_source
+            << " themeFiles=" << theme_fonts.size();
+  return manager;
+}
