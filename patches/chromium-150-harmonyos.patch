+struct OhosNativeTypeface {};
+struct OhosNativeFontManager {};
+struct OhosNativeData {};
+
+// HarmonyOS system libraries and applications use different libc++ ABI
+// namespaces. Keep system-owned shared references opaque at this boundary.
+struct OhosNativeSharedReference {
+  void* instance = nullptr;
+  void* control_block = nullptr;
+
+  OhosNativeSharedReference() = default;
+  OhosNativeSharedReference(const OhosNativeSharedReference&) = delete;
+  OhosNativeSharedReference& operator=(const OhosNativeSharedReference&) =
+      delete;
+  ~OhosNativeSharedReference() {}
+};
+
+static_assert(sizeof(OhosNativeSharedReference) == 2 * sizeof(void*));
+
+struct OhosNativeFontStyle {
+  uint32_t value = 400u + (5u << 16);
+};
+
+static_assert(sizeof(OhosNativeFontStyle) == sizeof(uint32_t));
+
+void* ResolveOhosNativeSymbol(void* library,
+                              void* dependency_root,
+                              const char* name) {
+  if (library) {
+    if (void* symbol = dlsym(library, name)) {
+      return symbol;
+    }
+  }
+  if (dependency_root && dependency_root != library) {
+    if (void* symbol = dlsym(dependency_root, name)) {
+      return symbol;
+    }
+  }
+  return dlsym(RTLD_DEFAULT, name);
+}
+
+void AppendUniqueThemeFontData(sk_sp<SkData> data,
+                               std::vector<sk_sp<SkData>>* fonts) {
+  if (!data || data->isEmpty() || data->size() > kMaxThemeFontFileSize) {
+    return;
+  }
+  if (std::any_of(fonts->begin(), fonts->end(),
+                  [&data](const sk_sp<SkData>& existing) {
+                    return data->equals(existing.get());
+                  })) {
+    return;
+  }
+  fonts->push_back(std::move(data));
+}
+
+std::vector<sk_sp<SkData>> ReadOhosNativeThemeFontData(bool* bridge_available) {
+  CHECK(bridge_available);
+  *bridge_available = false;
+  std::vector<sk_sp<SkData>> fonts;
+  void* native_drawing = dlopen("libnative_drawing.so", RTLD_NOW | RTLD_LOCAL);
+  if (!native_drawing) {
+    return fonts;
+  }
+  void* rosen_text = dlopen("librosen_text.z.so", RTLD_NOW | RTLD_LOCAL);
+  void* graphics = dlopen("lib2d_graphics.z.so", RTLD_NOW | RTLD_LOCAL);
+
+  // API 24 and API 26 use hidden shared_ptr return slots for GetFontMgr() and
+  // Serialize(), while MatchFamilyStyle() returns an unowned raw pointer.
+  using GetGlobalCollectionFunction = OH_Drawing_FontCollection* (*)();
+  using GetFontManagerFunction = OhosNativeSharedReference (*)(void*);
+  using MatchFamilyStyleFunction =
+      OhosNativeTypeface* (*)(const OhosNativeFontManager*, const char*,
+                              const OhosNativeFontStyle&);
+  using IsThemeTypefaceFunction = bool (*)(const OhosNativeTypeface*);
+  using SerializeTypefaceFunction =
+      OhosNativeSharedReference (*)(const OhosNativeTypeface*);
+  using GetDataFunction = const void* (*)(const OhosNativeData*);
+  using GetDataSizeFunction = size_t (*)(const OhosNativeData*);
+
+  auto get_global_collection = reinterpret_cast<GetGlobalCollectionFunction>(
+      ResolveOhosNativeSymbol(native_drawing, native_drawing,
+                              "OH_Drawing_GetFontCollectionGlobalInstance"));
+  auto get_font_manager =
+      reinterpret_cast<GetFontManagerFunction>(ResolveOhosNativeSymbol(
+          rosen_text, native_drawing,
+          "_ZN4OHOS5Rosen10AdapterTxt14FontCollection10GetFontMgrEv"));
+  auto match_family_style = reinterpret_cast<MatchFamilyStyleFunction>(
+      ResolveOhosNativeSymbol(graphics, native_drawing,
+                              "_ZNK4OHOS5Rosen7Drawing7FontMgr16MatchFamilyStyl"
+                              "eEPKcRKNS1_9FontStyleE"));
+  auto is_theme_typeface =
+      reinterpret_cast<IsThemeTypefaceFunction>(ResolveOhosNativeSymbol(
+          graphics, native_drawing,
+          "_ZNK4OHOS5Rosen7Drawing8Typeface15IsThemeTypefaceEv"));
+  auto serialize_typeface = reinterpret_cast<SerializeTypefaceFunction>(
+      ResolveOhosNativeSymbol(graphics, native_drawing,
+                              "_ZNK4OHOS5Rosen7Drawing8Typeface9SerializeEv"));
+  auto get_data = reinterpret_cast<GetDataFunction>(ResolveOhosNativeSymbol(
+      graphics, native_drawing, "_ZNK4OHOS5Rosen7Drawing4Data7GetDataEv"));
+  auto get_data_size =
+      reinterpret_cast<GetDataSizeFunction>(ResolveOhosNativeSymbol(
+          graphics, native_drawing, "_ZNK4OHOS5Rosen7Drawing4Data7GetSizeEv"));
+
+  if (get_global_collection && get_font_manager && match_family_style &&
+      is_theme_typeface && serialize_typeface && get_data && get_data_size) {
+    OH_Drawing_FontCollection* collection = get_global_collection();
+    OhosNativeSharedReference font_manager =
+        collection ? get_font_manager(collection) : OhosNativeSharedReference();
+    if (font_manager.instance) {
+      *bridge_available = true;
+      const OhosNativeFontStyle normal_style;
+      for (uint32_t index = 0; index < kMaxThemeFontFiles; ++index) {
+        std::string family = kOhosThemeFamily;
+        if (index > 0) {
+          family.append(std::to_string(index));
+        }
+        OhosNativeTypeface* native_typeface = match_family_style(
+            static_cast<OhosNativeFontManager*>(font_manager.instance),
+            family.c_str(), normal_style);
+        if (!native_typeface || !is_theme_typeface(native_typeface)) {
+          continue;
+        }
+
+        OhosNativeSharedReference serialized =
+            serialize_typeface(native_typeface);
+        if (!serialized.instance) {
+          continue;
+        }
+        const auto* native_data =
+            static_cast<OhosNativeData*>(serialized.instance);
+        const size_t serialized_size = get_data_size(native_data);
+        const void* serialized_bytes = get_data(native_data);
+        if (!serialized_bytes || serialized_size == 0 ||
+            serialized_size > kMaxThemeFontFileSize) {
+          continue;
+        }
+
+        SkMemoryStream serialized_stream(serialized_bytes, serialized_size,
+                                         false);
+        sk_sp<SkTypeface> chromium_typeface =
+            SkTypeface::MakeDeserialize(&serialized_stream, nullptr);
+        if (!chromium_typeface) {
+          LOG(WARNING) << "OHOS theme typeface serialization is incompatible "
+                          "with Chromium Skia family="
+                       << family;
+          continue;
+        }
+        int collection_index = 0;
+        std::unique_ptr<SkStreamAsset> font_stream =
+            chromium_typeface->openStream(&collection_index);
+        if (!font_stream || font_stream->getLength() == 0 ||
+            font_stream->getLength() > kMaxThemeFontFileSize) {
+          continue;
+        }
+        AppendUniqueThemeFontData(
+            SkData::MakeFromStream(font_stream.get(), font_stream->getLength()),
+            &fonts);
+      }
+    }
+  } else {
+    LOG(WARNING) << "OHOS Native Drawing theme font ABI is unavailable"
+                 << " native=" << !!native_drawing
+                 << " rosenText=" << !!rosen_text << " graphics=" << !!graphics
+                 << " getCollection=" << !!get_global_collection
+                 << " getFontMgr=" << !!get_font_manager
+                 << " matchFamily=" << !!match_family_style
+                 << " serialize=" << !!serialize_typeface
+                 << " data=" << !!get_data << " dataSize=" << !!get_data_size;
+  }
+
+  if (graphics) {
+    dlclose(graphics);
+  }
+  if (rosen_text) {
+    dlclose(rosen_text);
+  }
+  dlclose(native_drawing);
+  return fonts;
+}
+
+base::FilePath GetOhosThemeFontCachePath() {
+  if (!base::CommandLine::InitializedForCurrentProcess()) {
+    return {};
+  }
+  const base::FilePath user_data_dir =
+      base::CommandLine::ForCurrentProcess()->GetSwitchValuePath(
+          kUserDataDirSwitch);
+  if (!user_data_dir.IsAbsolute()) {
+    return {};
+  }
+  return user_data_dir.AppendASCII(kOhosThemeCacheFile);
+}
