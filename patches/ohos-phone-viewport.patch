+#if BUILDFLAG(IS_OHOS)
+// The viewport rules for a phone, in one place because two hooks need them.
+//
+// Web preferences are computed once per SiteInstance, and after a navigation
+// content only calls OverrideWebPreferencesAfterNavigation -- so anything
+// decided from the current URL has to be decided again there. Both of the
+// choices below change as the user browses: a tab that starts on a website
+// and then opens chrome://version, or one that switches to the desktop site.
+// Deciding them only in OverrideWebPreferences left both stuck at whatever
+// the tab was doing when its renderer was created.
+//
+// Returns true when it changed something, which is what the after-navigation
+// hook has to report so the new preferences are actually sent.
+bool ApplyOhosPhoneWebPreferences(WebContents* web_contents,
+                                  content::SiteInstance& main_frame_site,
+                                  WebPreferences* web_prefs) {
+  if (!chrome::ohos::IsAuraShellMobilePhoneUi()) {
+    return false;
+  }
+
+  // Ozone OHOS registers no touchscreen device; report the phone's touch
+  // input so pages see touch events and (pointer: coarse). Not URL-dependent,
+  // so it never needs revisiting.
+  web_prefs->touch_event_feature_detection_enabled = true;
+  web_prefs->pointer_events_max_touch_points = 10;
+  web_prefs->available_pointer_types =
+      static_cast<int>(blink::mojom::PointerType::kPointerCoarseType);
+  web_prefs->primary_pointer_type =
+      blink::mojom::PointerType::kPointerCoarseType;
+  web_prefs->available_hover_types =
+      static_cast<int>(blink::mojom::HoverType::kHoverNone);
+  web_prefs->primary_hover_type = blink::mojom::HoverType::kHoverNone;
+  web_prefs->default_minimum_page_scale_factor = 0.25f;
+  web_prefs->default_maximum_page_scale_factor = 5.0f;
+
+  // WebUI is written for a desktop window and almost none of it declares a
+  // <meta viewport>: 29 files in all of chrome/browser/resources do, and
+  // password_manager.html is not one. Under the mobile rules it would be laid
+  // out at 980px and shrunk to fit, which is right for an old website and
+  // leaves chrome:// pages at about a third size. Give it the window's own
+  // width, the way desktop does.
+  //
+  // Read from the committed URL rather than the SiteInstance: the site of the
+  // initial about:blank entry says nothing about where the tab went next.
+  const GURL url = web_contents ? web_contents->GetLastCommittedURL() : GURL();
+  const bool is_web_ui =
+      url.SchemeIs(content::kChromeUIScheme) ||
+      url.SchemeIs(content::kChromeUIUntrustedScheme) ||
+      main_frame_site.GetSecurityPrincipal().SchemeIs(
+          content::kChromeUIScheme) ||
+      main_frame_site.GetSecurityPrincipal().SchemeIs(
+          content::kChromeUIUntrustedScheme);
+
+  // Asking for the desktop site has to ignore the page's own <meta viewport>
+  // as well as swap the user agent, or a responsive site reads the phone's
+  // width and lays out for a phone anyway -- the site was never the problem.
+  // content does this for us a few lines before it calls this, and then this
+  // runs and would put it back, so decide it here instead.
+  content::NavigationEntry* entry =
+      web_contents ? web_contents->GetController().GetVisibleEntry() : nullptr;
+  const bool desktop_site = entry && entry->GetIsOverridingUserAgent();
+
+  const bool viewport_enabled = !is_web_ui;
+  const bool viewport_meta_enabled = !is_web_ui && !desktop_site;
+  const blink::mojom::ViewportStyle viewport_style =
+      is_web_ui ? blink::mojom::ViewportStyle::kDefault
+                : blink::mojom::ViewportStyle::kMobile;
+
+  const bool changed =
+      web_prefs->viewport_enabled != viewport_enabled ||
+      web_prefs->viewport_meta_enabled != viewport_meta_enabled ||
+      web_prefs->viewport_style != viewport_style ||
+      web_prefs->shrinks_viewport_contents_to_fit == is_web_ui ||
+      web_prefs->main_frame_resizes_are_orientation_changes == is_web_ui ||
+      web_prefs->double_tap_to_zoom_enabled == is_web_ui;
+
+  web_prefs->viewport_enabled = viewport_enabled;
+  web_prefs->viewport_meta_enabled = viewport_meta_enabled;
+  web_prefs->viewport_style = viewport_style;
+  web_prefs->shrinks_viewport_contents_to_fit = !is_web_ui;
+  web_prefs->main_frame_resizes_are_orientation_changes = !is_web_ui;
+  web_prefs->double_tap_to_zoom_enabled = !is_web_ui;
+  return changed;
+}
+#endif  // BUILDFLAG(IS_OHOS)
