@@ -1418,6 +1437,14 @@ source_set("core") {
       "//chrome/browser/security_events",
       "//chrome/browser/sensor",
     ]
+
+    # The shell's bookmark, history and address-bar pages
+    # (ui/ohos/shell_*_ohos.cc) read these directly; elsewhere only :browser
+    # (bookmarks) and Android (autocomplete) depend on them.
+    deps += [
+      "//chrome/browser/autocomplete",
+      "//chrome/browser/bookmarks",
+    ]
   }
 
   if (!is_android || is_desktop_android) {
