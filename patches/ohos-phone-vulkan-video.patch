+  bool ResumeOhosNativeReadAccess() override {
+    if (access_active_)
+      return true;
+    if (!texture_)
+      return false;
+    // A Vulkan queue-family acquire is exclusive even for a logical read.
+    if (!backing_->BeginAccess(false, &begin_semaphores_, false))
+      return false;
