+      AbortBeginAccess();
+      backing_->QuarantineOhosVideoAccess();
+      return false;
+    }
+    access_active_ = true;
+    TRACE_EVENT_INSTANT("gpu", "OhosNativeVideoReadResume");
+    return true;
+  }
