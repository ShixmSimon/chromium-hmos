diff --git a/ui/gfx/mojom/native_handle_types_mojom_traits.cc b/ui/gfx/mojom/native_handle_types_mojom_traits.cc
--- a/ui/gfx/mojom/native_handle_types_mojom_traits.cc
+++ b/ui/gfx/mojom/native_handle_types_mojom_traits.cc
@@ -141,6 +141,33 @@
   out->ram_coherency = data.ram_coherency();
 #endif
 
+#if BUILDFLAG(IS_OHOS)
+  mojo::ArrayDataView<uint32_t> prefix;
+  mojo::ArrayDataView<uint8_t> tail;
+  mojo::ArrayDataView<mojo::PlatformHandle> fds;
+  data.GetOhosBufferPrefixDataView(&prefix);
+  data.GetOhosBufferTailDataView(&tail);
+  data.GetOhosBufferFdsDataView(&fds);
+  if ((prefix.size() != 0 && prefix.size() != 14) || tail.size() > 1044 ||
+      fds.size() > 7)
+    return false;
+  std::vector<mojo::PlatformHandle> handles;
+  if (!data.ReadOhosBufferPrefix(&out->ohos_buffer_prefix) ||
+      !data.ReadOhosBufferTail(&out->ohos_buffer_tail) ||
+      !data.ReadOhosBufferFds(&handles))
+    return false;
+  for (auto& h : handles) {
+    if (!h.is_fd())
+      return false;
+    out->ohos_buffer_fds.push_back(h.TakeFD());
+  }
+  auto release = data.TakeOhosVideoReleaseFd();
+  if (release.is_valid()) {
+    if (!release.is_fd())
+      return false;
+    out->ohos_video_release_fd = release.TakeFD();
+  }
+#endif
   return data.ReadPlanes(&out->planes);
 }
 #endif  // BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_CHROMEOS) || BUILDFLAG(IS_OZONE)
