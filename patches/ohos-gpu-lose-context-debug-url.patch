--- a/components/viz/service/gl/gpu_service_impl.cc
+++ b/components/viz/service/gl/gpu_service_impl.cc
@@ -1222,6 +1222,21 @@ void GpuServiceImpl::Hang() {
   main_runner_->PostTask(FROM_HERE, base::BindOnce(&gl::Hang));
 }
 
+void GpuServiceImpl::LoseContextForTesting() {
+  if (!main_runner_->BelongsToCurrentThread()) {
+    main_runner_->PostTask(
+        FROM_HERE,
+        base::BindOnce(&GpuServiceImpl::LoseContextForTesting, weak_ptr_));
+    return;
+  }
+  LOG(WARNING) << "GPU: losing the shared context on request";
+  // A count of -1 means "the next one", and not synthetic: this is meant to
+  // be indistinguishable, from here on, from the driver having lost it.
+  gpu_channel_manager_->OnContextLost(/*context_lost_count=*/-1,
+                                      /*synthetic_loss=*/false,
+                                      gpu::error::kUnknown);
+}
+
