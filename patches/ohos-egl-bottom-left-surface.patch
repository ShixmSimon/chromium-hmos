+#if !BUILDFLAG(IS_OHOS)
   if (display_->ext->b_EGL_ANGLE_surface_orientation) {
     EGLint attrib;
     eglGetConfigAttrib(display_->GetDisplay(), GetConfig(),
@@ -396,6 +406,7 @@ bool NativeViewGLSurfaceEGL::Initialize(GLSurfaceFormat format) {
