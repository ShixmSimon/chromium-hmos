@@ -205,6 +222,21 @@ bool SkiaOutputDeviceGL::Reshape(const ReshapeParams& params) {
     base::debug::Alias(nullptr);
     return false;
   }
+#if BUILDFLAG(IS_OHOS)
+  // A queued SDR8 reshape must not describe a ten-bit default framebuffer
+  // as RGBA8 while the browser handles the new display capability event.
+  if (!gl_surface_->GetBackingFramebufferObject()) {
+    // Copy-output may leave an offscreen FBO bound. Its GL_RED_BITS does not
+    // describe framebuffer zero; use the live native EGL window contract.
+    const auto native_spaces =
+        ui::GetOhosEglOutputColorSpaces(gl_surface_.get());
+    if (native_spaces &&
+        native_spaces->GetOutputFormat(gfx::ContentColorUsage::kSRGB, false) ==
+            SinglePlaneFormat::kRGBA_1010102) {
+      color_type = kRGBA_1010102_SkColorType;
+    }
+  }
+#endif
   SkSurfaceProps surface_props;
 
   GrGLFramebufferInfo framebuffer_info = {0};
