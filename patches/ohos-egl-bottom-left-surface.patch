+#if BUILDFLAG(IS_OHOS)
+  // Capability publication may reach the browser after the first frame was
+  // scheduled. Always wrap the actual default framebuffer format, including
+  // that initial SDR frame on a successfully negotiated ten-bit EGL config.
+  int red_bits = 0;
+  glGetIntegerv(GL_RED_BITS, &red_bits);
+  if (red_bits == 10 && alpha_bits == 2)
+    color_type = kRGBA_1010102_SkColorType;
+  capabilities_.ohos_output_color_spaces =
+      ui::GetOhosEglOutputColorSpaces(gl_surface_.get());
+  capabilities_.ohos_dynamic_output_luminance =
+      capabilities_.ohos_output_color_spaces.has_value() &&
+      ui::OhosDynamicOutputLuminance();
+#endif
   // SRGB
   capabilities_.sk_color_type_map[SinglePlaneFormat::kRGBA_8888] = color_type;
   capabilities_.sk_color_type_map[SinglePlaneFormat::kRGBX_8888] = color_type;
@@ -195,7 +212,7 @@ bool SkiaOutputDeviceGL::Reshape(const ReshapeParams& params) {
 #endif  // !BUILDFLAG(IS_CHROMEOS)
 
   const gfx::Size size = params.GfxSize();
-  const SkColorType color_type = params.image_info.colorType();
+  SkColorType color_type = params.image_info.colorType();
