 #if BUILDFLAG(IS_CHROMEOS_DEVICE)
   auto info =
       std::unique_ptr<sync_fence_info_data, void (*)(sync_fence_info_data*)>{
@@ -114,7 +117,8 @@ GpuFence::FenceStatus GpuFence::GetStatusChangeTime(int fd,
