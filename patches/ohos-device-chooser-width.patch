Fit the device chooser inside a phone screen.

DeviceChooserContentView asks for a fixed 402dp of width. On the device this
port runs on the work area is 377dp, and a bubble is not shrunk to fit: the
chooser was laid out 462dp wide (measured, bounds=34,-4 462x483), its right
edge past the display, and the Connect button sat where no touch could reach
it. Selecting a device by touch worked and still could not be confirmed.

The width is now the smaller of 402dp and what the work area leaves once the
bubble frame is accounted for. Desktop is untouched.

Generated against Chromium 154.0.8037.51.

Apply with:
  git -C /path/to/chromium/src apply /path/to/patches/ohos-device-chooser-width.patch

diff --git a/chrome/browser/ui/views/device_chooser_content_view.cc b/chrome/browser/ui/views/device_chooser_content_view.cc
index 30f20e9..9f87bb2 100644
--- a/chrome/browser/ui/views/device_chooser_content_view.cc
+++ b/chrome/browser/ui/views/device_chooser_content_view.cc
@@ -4,10 +4,12 @@
 
 #include "chrome/browser/ui/views/device_chooser_content_view.h"
 
+#include <algorithm>
 #include <array>
 #include <string>
 
 #include "base/functional/bind.h"
+#include "build/build_config.h"
 #include "base/numerics/safe_conversions.h"
 #include "base/strings/strcat.h"
 #include "chrome/browser/ui/views/chrome_layout_provider.h"
@@ -20,6 +22,8 @@
 #include "ui/base/mojom/dialog_button.mojom.h"
 #include "ui/base/resource/resource_bundle.h"
 #include "ui/base/ui_base_features.h"
+#include "ui/display/display.h"
+#include "ui/display/screen.h"
 #include "ui/gfx/color_palette.h"
 #include "ui/gfx/geometry/point.h"
 #include "ui/gfx/geometry/rect.h"
@@ -51,7 +55,25 @@ DeviceChooserContentView::DeviceChooserContentView(
     : chooser_controller_(std::move(chooser_controller)) {
   chooser_controller_->set_view(this);
 
+#if BUILDFLAG(IS_OHOS)
+  // 402dp is wider than the phone this port runs on (377dp of work area), and
+  // a bubble is not shrunk to fit what is left: the chooser rendered with its
+  // right edge past the display, which put the Connect button where no touch
+  // could reach it. Leave the bubble frame room on both sides instead -- 60dp
+  // of it on the device measured, rounded up -- so the whole bubble lands
+  // inside the screen. Desktop keeps the fixed width, and so does a startup
+  // with no screen to ask.
+  constexpr int kPreferredWidth = 402;
+  constexpr int kBubbleFrameAllowance = 64;
+  int width = kPreferredWidth;
+  if (display::Screen* screen = display::Screen::Get()) {
+    width = std::min(width, screen->GetPrimaryDisplay().work_area().width() -
+                                kBubbleFrameAllowance);
+  }
+  SetPreferredSize(gfx::Size(width, 320));
+#else
   SetPreferredSize(gfx::Size(402, 320));
+#endif
   SetProperty(views::kElementIdentifierKey,
               kDeviceChooserDialogBubbleElementId);
 
