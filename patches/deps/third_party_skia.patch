+namespace {
+
+// Family-name suffix of the CJK variant preferred for a BCP 47 language tag.
+const char* cjk_family_suffix(const char* tag) {
+    if (!tag) {
+        return nullptr;
+    }
+    if (strncmp(tag, "zh", 2) == 0) {
+        const bool traditional = strstr(tag, "Hant") || strstr(tag, "-TW") ||
+                                 strstr(tag, "-HK") || strstr(tag, "-MO");
+        return traditional ? " TC" : " SC";
+    }
+    if (strncmp(tag, "ja", 2) == 0) {
+        return " JP";
+    }
+    if (strncmp(tag, "ko", 2) == 0) {
+        return " KR";
+    }
+    return nullptr;
+}
+
+}  // namespace
+
+sk_sp<SkTypeface> SkFontMgr_Custom::matchCharacterInFamily(SkFontStyleSet_Custom* family,
+                                                           const SkFontStyle& style,
+                                                           SkUnichar character) const {
+    sk_sp<SkTypeface> typeface = family->matchStyle(style);
+    if (typeface && typeface->unicharToGlyph(character) != 0) {
+        return typeface;
+    }
+    return nullptr;
+}
+
 sk_sp<SkTypeface> SkFontMgr_Custom::onMatchFamilyStyleCharacter(
-    const char familyName[], const SkFontStyle&,
+    const char familyName[], const SkFontStyle& style,
     const char* bcp47[], int bcp47Count,
-    SkUnichar) const
+    SkUnichar character) const
 {
+    SkAutoMutexExclusive lock(fFallbackMutex);
+
+    if (familyName) {
+        for (const sk_sp<SkFontStyleSet_Custom>& family : fFamilies) {
+            if (family->getFamilyName().equals(familyName)) {
+                if (sk_sp<SkTypeface> typeface =
+                            this->matchCharacterInFamily(family.get(), style, character)) {
+                    return typeface;
+                }
+            }
+        }
+    }
+
+    // The last language tag is the most preferred one.
+    for (int tagIndex = bcp47Count; tagIndex-- > 0;) {
+        const char* suffix = cjk_family_suffix(bcp47[tagIndex]);
+        if (!suffix) {
+            continue;
+        }
+        for (const sk_sp<SkFontStyleSet_Custom>& family : fFamilies) {
+            if (!family->getFamilyName().endsWith(suffix)) {
+                continue;
+            }
+            if (sk_sp<SkTypeface> typeface =
+                        this->matchCharacterInFamily(family.get(), style, character)) {
+                fLastFallbackFamily = family.get();
+                return typeface;
+            }
+        }
+    }
+
+    // Consecutive characters usually come from the same script.
+    if (fLastFallbackFamily) {
+        if (sk_sp<SkTypeface> typeface =
+                    this->matchCharacterInFamily(fLastFallbackFamily, style, character)) {
+            return typeface;
+        }
+    }
+
+    for (const sk_sp<SkFontStyleSet_Custom>& family : fFamilies) {
+        if (sk_sp<SkTypeface> typeface =
+                    this->matchCharacterInFamily(family.get(), style, character)) {
+            fLastFallbackFamily = family.get();
+            return typeface;
+        }
+    }
     return nullptr;
 }
 
