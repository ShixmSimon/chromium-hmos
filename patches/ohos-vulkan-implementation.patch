 declare_args() {
   # Enable experimental vulkan backend.
-  enable_vulkan = is_linux || is_chromeos || is_android || is_fuchsia
+  # OHOS is its own platform here, not one of the above: it has
+  # VK_OHOS_surface and a libvulkan.so, so Vulkan can be built for it. Off
+  # unless asked for, like everywhere else -- this only makes asking
+  # possible.
+  enable_vulkan =
+      is_linux || is_chromeos || is_android || is_fuchsia || is_ohos
 
   # Enable swiftshader vulkan. Disabling it can save build time, however
   # --use-vulkan=swiftshader and some tests which use swiftshader vulkan will
