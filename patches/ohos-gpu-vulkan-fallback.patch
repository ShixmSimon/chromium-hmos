+
+// Says what Skia was given when it would not make a GrContext: the versions
+// it compares, whether it has a memory allocator, the extensions, and any
+// function it requires that the lookup Skia uses cannot find.
+void DescribeOhosSkiaVulkanFailure(
+    const skgpu::VulkanBackendContext& context,
+    const std::vector<const char*>& instance_extensions,
+    const std::vector<const char*>& device_extensions) {
+  uint32_t instance_version = 0;
+  auto enumerate_instance_version =
+      reinterpret_cast<PFN_vkEnumerateInstanceVersion>(context.fGetProc(
+          "vkEnumerateInstanceVersion", VK_NULL_HANDLE, VK_NULL_HANDLE));
+  if (enumerate_instance_version) {
+    enumerate_instance_version(&instance_version);
+  }
+  VkPhysicalDeviceProperties properties = {};
+  auto get_properties = reinterpret_cast<PFN_vkGetPhysicalDeviceProperties>(
+      context.fGetProc("vkGetPhysicalDeviceProperties", context.fInstance,
+                       VK_NULL_HANDLE));
+  if (get_properties) {
+    get_properties(context.fPhysicalDevice, &properties);
+  }
+  LOG(ERROR) << "OHOS Vulkan: Skia made no GrContext. Instance "
+             << OhosVulkanVersion(instance_version) << ", device "
+             << OhosVulkanVersion(properties.apiVersion) << " ("
+             << properties.deviceName << "), max asked "
+             << OhosVulkanVersion(context.fMaxAPIVersion)
+             << ", memory allocator "
+             << (context.fMemoryAllocator ? "present" : "MISSING")
+             << ", features2 "
+             << (context.fDeviceFeatures2 ? "present" : "MISSING");
+  std::string extensions;
+  for (const char* name : instance_extensions) {
+    extensions += std::string(" ") + name;
+  }
+  LOG(ERROR) << "OHOS Vulkan: instance extensions:" << extensions;
+  extensions.clear();
+  for (const char* name : device_extensions) {
+    extensions += std::string(" ") + name;
+  }
+  LOG(ERROR) << "OHOS Vulkan: device extensions:" << extensions;
+
+  std::string missing;
+  for (const char* name : kOhosSkiaGlobalProcs) {
+    if (!context.fGetProc(name, VK_NULL_HANDLE, VK_NULL_HANDLE)) {
+      missing += std::string(" ") + name;
+    }
+  }
+  for (const char* name : kOhosSkiaInstanceProcs) {
+    if (!context.fGetProc(name, context.fInstance, VK_NULL_HANDLE)) {
+      missing += std::string(" ") + name;
+    }
+  }
+  for (const char* name : kOhosSkiaDeviceProcs) {
+    if (!context.fGetProc(name, VK_NULL_HANDLE, context.fDevice)) {
+      missing += std::string(" ") + name;
+    }
+  }
+  LOG(ERROR) << "OHOS Vulkan: functions Skia requires and cannot find:"
+             << (missing.empty() ? std::string(" none") : missing);
+}
