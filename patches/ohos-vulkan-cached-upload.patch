+#if BUILDFLAG(IS_OHOS)
+      // Large CPU video uploads need cached staging memory on unified-memory
+      // phone GPUs. Coherent-only selection can choose uncached device memory.
+      // Skia's VulkanAlloc tracks noncoherent memory and GrVkBuffer::vkUnmap
+      // flushes it through VMA before submission. Cached is a preference, so
+      // drivers without such a memory type retain the host-visible fallback.
+      info.requiredFlags = VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT;
+      info.preferredFlags = VK_MEMORY_PROPERTY_HOST_CACHED_BIT;
+#else
       info.requiredFlags = VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT |
                            VK_MEMORY_PROPERTY_HOST_COHERENT_BIT;
       info.preferredFlags = 0;
+#endif
       break;
     case BufferUsage::kTransfersFromGpuToCpu:
