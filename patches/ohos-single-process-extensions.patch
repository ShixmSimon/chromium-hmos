@@ -98,11 +99,27 @@ int ProcessMap::Remove(content::ChildProcessId process_id) {
 
 bool ProcessMap::Contains(const ExtensionId& extension_id_in,
                           content::ChildProcessId process_id) const {
+#if BUILDFLAG(IS_OHOS)
+  // A phone runs single-process: one renderer, inside the browser, holds
+  // every page and every extension. The map keeps one extension per
+  // process, so whichever extension started first owned it and every other
+  // one was "not in its process" -- its page's own stylesheets and scripts
+  // were refused, its API context was taken for a web page's. Every
+  // extension is in the one process there is.
+  if (content::RenderProcessHost::run_renderer_in_process()) {
+    return true;
+  }
+#endif
   auto* extension_id = base::FindOrNull(items_, process_id);
   return extension_id && *extension_id == extension_id_in;
 }
 
 bool ProcessMap::Contains(content::ChildProcessId process_id) const {
+#if BUILDFLAG(IS_OHOS)
+  if (content::RenderProcessHost::run_renderer_in_process()) {
+    return true;
+  }
+#endif
   return items_.contains(process_id);
 }
 
@@ -229,6 +246,18 @@ mojom::ContextType ProcessMap::GetMostLikelyContextType(
   }
 
   const ExtensionId& extension_id = extension->id();
+#if BUILDFLAG(IS_OHOS)
+  // With one process for everything, Contains() is true for every
+  // extension, and without this every context an extension has on a web
