 #    define ANGLE_PLATFORM_ANDROID 1
 #    define ANGLE_PLATFORM_POSIX 1
+#elif defined(__OHOS__)
+// Ahead of the linux arm on purpose: OHOS defines __linux__ as well, and
+// being taken for desktop Linux is what sent the Vulkan backend looking for
+// a windowing system it does not have.
+#    define ANGLE_PLATFORM_OHOS 1
+#    define ANGLE_PLATFORM_POSIX 1
 #elif defined(__linux__) || defined(EMSCRIPTEN)
 #    define ANGLE_PLATFORM_LINUX 1
 #    define ANGLE_PLATFORM_POSIX 1
