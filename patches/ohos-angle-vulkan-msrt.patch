diff --git a/src/libANGLE/renderer/vulkan/vk_helpers.cpp b/src/libANGLE/renderer/vulkan/vk_helpers.cpp
index b5142fa1..4d726781 100644
--- a/src/libANGLE/renderer/vulkan/vk_helpers.cpp
+++ b/src/libANGLE/renderer/vulkan/vk_helpers.cpp
@@ -9,6 +9,7 @@
 #include "libANGLE/renderer/vulkan/vk_helpers.h"
 
 #include <array>
+#include <atomic>
 
 #include "common/unsafe_buffers.h"
 
@@ -6191,8 +6192,31 @@ bool ImageHelper::FormatSupportsUsage(const Renderer *renderer,
     if (formatSupportCheck == FormatSupportCheck::RequireMultisampling)
     {
         // Some drivers return success but sampleCounts == 1 which means no MSRTT
-        return result == VK_SUCCESS &&
-               imageFormatProperties2.imageFormatProperties.sampleCounts > 1;
+        const bool supported = result == VK_SUCCESS &&
+                               imageFormatProperties2.imageFormatProperties.sampleCounts > 1;
+#if defined(ANGLE_PLATFORM_OHOS)
+        if (!supported &&
+            (createFlags & VK_IMAGE_CREATE_MULTISAMPLED_RENDER_TO_SINGLE_SAMPLED_BIT_EXT) != 0)
+        {
+            // Startup probes and texture recreation share this query. Bound diagnostics
+            // across threads; a failed frame must not flood hilog with format details.
+            static std::atomic<unsigned int> remainingLogs{8};
+            unsigned int remaining = remainingLogs.load(std::memory_order_relaxed);
+            while (remaining != 0 &&
+                   !remainingLogs.compare_exchange_weak(remaining, remaining - 1,
+                                                        std::memory_order_relaxed))
+            {}
+            if (remaining != 0)
+            {
+                WARN() << "OHOS ANGLE Vulkan MSRT query rejected: format=" << format
+                       << " type=" << imageType << " tiling=" << tilingMode
+                       << " usage=" << usageFlags << " flags=" << createFlags
+                       << " result=" << result << " sampleCounts="
+                       << imageFormatProperties2.imageFormatProperties.sampleCounts;
+            }
+        }
+#endif
+        return supported;
     }
     return result == VK_SUCCESS;
 }
