+    WARN() << "OHOS ANGLE Vulkan MSRT: device=" << mPhysicalDeviceProperties.deviceName
+           << " vendor=" << mPhysicalDeviceProperties.vendorID
+           << " deviceId=" << mPhysicalDeviceProperties.deviceID
+           << " driverVersion=" << mPhysicalDeviceProperties.driverVersion
+           << " apiVersion=" << mPhysicalDeviceProperties.apiVersion
+           << " nativeMSRTSS=" << mFeatures.supportsMultisampledRenderToSingleSampled.enabled
+           << " emulateMSRTT="
+           << (mFeatures.enableMultisampledRenderToTexture.enabled &&
+               !mFeatures.supportsMultisampledRenderToSingleSampled.enabled)
+           << " exposeMSRTT=" << mFeatures.enableMultisampledRenderToTexture.enabled;
+#endif
+
     // Currently we enable cube map arrays based on the imageCubeArray Vk feature.
     // TODO: Check device caps for full cube map array support. http://anglebug.com/42263705
     ANGLE_FEATURE_CONDITION(&mFeatures, supportsImageCubeArray,
