             !isLavapipe);
 
+#if defined(ANGLE_PLATFORM_OHOS)
+    // The RGBA8 startup probe does not cover all format/usage/view combinations.
+    // On OHOS a later TextureVk::initImage query can reject an MSRTT attachment,
+    // failing page rasterization repeatedly (GEM-W00, 2026-10-13). Until those
+    // combinations are validated on device, use the existing MSRTT emulation
+    // eligibility checks below, or let clients use ordinary multisample FBOs.
+    // Set this before all dependent features and device extension enablement.
+    // Explicit ANGLE feature overrides remain available for diagnosis.
+    ANGLE_FEATURE_CONDITION(&mFeatures, supportsMultisampledRenderToSingleSampled, false);
+#endif
