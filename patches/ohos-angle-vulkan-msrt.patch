+#if defined(ANGLE_PLATFORM_OHOS)
+angle::Result CommandQueue::waitForPresentIdle(ErrorContext *context)
+{
+    ANGLE_TRACE_EVENT0("gpu.angle", "CommandQueue::waitForPresentIdle");
+    VkResult result;
+    {
+        std::lock_guard<angle::SimpleMutex> lock(mQueueSubmitMutex);
+        result = VK_CALL(vkDeviceWaitIdle, context->getDevice());
+    }
+    // Report errors after releasing the submission lock: device-loss cleanup
+    // takes that same lock while draining the queue.
+    ANGLE_VK_TRY(context, result);
+    return angle::Result::Continue;
+}
+#endif
