+#if BUILDFLAG(IS_OHOS)
+namespace {
+
+// How long one stage of drawing takes, logged every 300 calls ("OHOS gpu
+// stage"). HDR 1080p60 video dropped a third of its frames on a Mate 70
+// Pro+ in the default power mode, SDR none: viz took 5-7 ms to acknowledge
+// an HDR video frame against about 1 ms for SDR, about half the drops went
+// with the system's HDR composition of the window, and this times the
+// rest -- the upload of each video frame's planes, viz's DrawAndSwap, and
+// the GPU thread's FinishPaintCurrentFrame and SwapBuffers. Each stage runs
+// on one thread, so the counts need no lock.
+struct OhosStageTimes {
+  int calls = 0;
+  int over_8ms = 0;
+  base::TimeDelta total;
+  base::TimeDelta max;
+};
+
+class OhosStageTimer {
+ public:
+  OhosStageTimer(OhosStageTimes& times, const char* stage)
+      : times_(times), stage_(stage), start_(base::TimeTicks::Now()) {}
+  OhosStageTimer(const OhosStageTimer&) = delete;
+  OhosStageTimer& operator=(const OhosStageTimer&) = delete;
+  ~OhosStageTimer() {
+    const base::TimeDelta elapsed = base::TimeTicks::Now() - start_;
+    ++times_.calls;
+    times_.total += elapsed;
+    times_.max = std::max(times_.max, elapsed);
+    if (elapsed > base::Milliseconds(8)) {
+      ++times_.over_8ms;
+    }
+    if (times_.calls < 300) {
+      return;
+    }
+    LOG(WARNING) << "OHOS gpu stage " << stage_ << ": " << times_.calls
+                 << " calls, avg "
+                 << (times_.total / times_.calls).InMillisecondsF()
+                 << " ms, max " << times_.max.InMillisecondsF() << " ms, "
+                 << times_.over_8ms << " over 8 ms";
+    times_ = OhosStageTimes();
+  }
+
+ private:
+  OhosStageTimes& times_;
+  const char* const stage_;
+  const base::TimeTicks start_;
+};
+
+}  // namespace
+#endif  // BUILDFLAG(IS_OHOS)
