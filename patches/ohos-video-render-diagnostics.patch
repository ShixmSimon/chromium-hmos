@@ -47,6 +53,63 @@ perfetto::NamedTrack GetTracingTrack(const VideoRendererImpl* renderer) {
 // SetLatencyHint(), so we needed to peg this with a constant.
 constexpr int kAbsoluteMaxFrames = 24;
 
+#if BUILDFLAG(IS_OHOS)
+// Where dropped frames come from, logged every five seconds ("OHOS video
+// render"). Render() runs once per begin-frame of the display and counts a
+// frame dropped when it goes by without being shown. If the queue had no
+// frame ready when it ran, the decoder was behind; if Render() itself came
+// late, the thread that calls it was. YouTube's 1080p60 HDR dropped a third
+// of its frames on a Mate 70 Pro+ with only an eighth decoded late.
+struct OhosRenderStats {
+  base::Lock lock;
+  base::TimeTicks window_start;
+  int calls = 0;
+  int gaps_over_20ms = 0;
+  int nothing_ready = 0;
+  size_t dropped = 0;
+  base::TimeDelta longest_gap;
+};
+
+void RecordOhosRender(base::TimeTicks now,
+                      base::TimeDelta gap,
+                      size_t frames_dropped,
+                      size_t effective_frames_queued) {
+  static base::NoDestructor<OhosRenderStats> stats;
+  base::AutoLock hold(stats->lock);
+  if (stats->window_start.is_null()) {
+    stats->window_start = now;
+  }
+  ++stats->calls;
+  stats->dropped += frames_dropped;
+  if (effective_frames_queued == 0) {
+    ++stats->nothing_ready;
+  }
+  // The first call after a pause has no gap worth counting.
+  if (gap < base::Seconds(1)) {
+    stats->longest_gap = std::max(stats->longest_gap, gap);
+    if (gap > base::Milliseconds(20)) {
+      ++stats->gaps_over_20ms;
+    }
+  }
+  const base::TimeDelta window = now - stats->window_start;
+  if (window < base::Seconds(5)) {
+    return;
+  }
+  LOG(WARNING) << "OHOS video render: " << stats->calls << " calls in "
+               << window.InSecondsF() << " s, longest gap "
+               << stats->longest_gap.InMillisecondsF() << " ms, "
+               << stats->gaps_over_20ms << " gaps over 20 ms, "
+               << stats->nothing_ready << " with no frame ready, "
+               << stats->dropped << " frames dropped";
+  stats->window_start = now;
+  stats->calls = 0;
+  stats->gaps_over_20ms = 0;
+  stats->nothing_ready = 0;
+  stats->dropped = 0;
+  stats->longest_gap = base::TimeDelta();
+}
+#endif  // BUILDFLAG(IS_OHOS)
+
 }  // namespace
 
