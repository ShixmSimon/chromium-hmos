+
 namespace media {
+
+#if BUILDFLAG(IS_OHOS)
+namespace {
+
+// How long a software-decoded frame takes to get to the GPU, logged every
+// 300 frames ("OHOS video upload"): the conversion a 10-bit frame needs
+// whatever the texture format, and the upload. It runs on the thread that
+// also answers the display's begin-frames, so a slow one can cost frames
+// the decoder delivered in time -- YouTube's 1080p60 HDR dropped a third of
+// its frames on a Mate 70 Pro+ with only an eighth of them decoded late.
+struct OhosUploadTimes {
+  base::Lock lock;
+  int frames = 0;
+  int over_8ms = 0;
+  base::TimeDelta total;
+  base::TimeDelta max;
+};
+
+class OhosSoftwareUploadTimer {
+ public:
+  OhosSoftwareUploadTimer(const VideoFrame& frame,
+                          const viz::SharedImageFormat& format)
+      : start_(base::TimeTicks::Now()),
+        size_(frame.coded_size()),
+        bits_(frame.BitDepth()),
+        format_(format) {}
+  OhosSoftwareUploadTimer(const OhosSoftwareUploadTimer&) = delete;
+  OhosSoftwareUploadTimer& operator=(const OhosSoftwareUploadTimer&) = delete;
+
+  ~OhosSoftwareUploadTimer() {
+    const base::TimeDelta elapsed = base::TimeTicks::Now() - start_;
+    static base::NoDestructor<OhosUploadTimes> times;
+    base::AutoLock hold(times->lock);
+    ++times->frames;
+    times->total += elapsed;
+    times->max = std::max(times->max, elapsed);
+    if (elapsed > base::Milliseconds(8)) {
+      ++times->over_8ms;
+    }
+    if (times->frames < 300) {
+      return;
+    }
+    LOG(WARNING) << "OHOS video upload: " << size_.ToString() << " "
+                 << bits_ << "-bit as " << format_.ToString() << ", "
+                 << times->frames << " frames, avg "
+                 << (times->total / times->frames).InMillisecondsF()
+                 << " ms, max " << times->max.InMillisecondsF() << " ms, "
+                 << times->over_8ms << " over 8 ms";
+    times->frames = 0;
+    times->over_8ms = 0;
+    times->total = base::TimeDelta();
+    times->max = base::TimeDelta();
+  }
+
+ private:
+  const base::TimeTicks start_;
+  const gfx::Size size_;
+  const size_t bits_;
+  const viz::SharedImageFormat format_;
+};
+
+}  // namespace
+#endif  // BUILDFLAG(IS_OHOS)
