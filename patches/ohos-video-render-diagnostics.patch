+struct OhosRenderStats {
+  base::Lock lock;
+  base::TimeTicks window_start;
+  int calls = 0;
+  int gaps_over_20ms = 0;
+  size_t dropped = 0;
+  base::TimeDelta longest_gap;
+  size_t queued_min = std::numeric_limits<size_t>::max();
+  size_t queued_total = 0;
+  base::TimeDelta gap_total;
+  int gaps = 0;
+  base::TimeDelta interval_min = base::TimeDelta::Max();
+  base::TimeDelta interval_max;
+  base::TimeDelta interval_total;
+  base::TimeTicks read_start;
+  base::TimeTicks last_frame_ready;
+  int reads = 0;
+  base::TimeDelta read_total;
+  base::TimeDelta read_max;
+  int waits = 0;
+  base::TimeDelta wait_total;
+  base::TimeDelta wait_max;
+  int arrived = 0;
+  int late = 0;
+  int under_a_frame = 0;
+  base::TimeDelta least_lead = base::TimeDelta::Max();
+};
+
+OhosRenderStats& GetOhosRenderStats() {
+  static base::NoDestructor<OhosRenderStats> stats;
+  return *stats;
+}
+
+void RecordOhosRead(base::TimeTicks now) {
+  OhosRenderStats& stats = GetOhosRenderStats();
+  base::AutoLock hold(stats.lock);
+  stats.read_start = now;
+  if (stats.last_frame_ready.is_null()) {
+    return;
+  }
+  const base::TimeDelta wait = now - stats.last_frame_ready;
+  if (wait < base::Seconds(1)) {
+    ++stats.waits;
+    stats.wait_total += wait;
+    stats.wait_max = std::max(stats.wait_max, wait);
+  }
+}
+
+void RecordOhosFrameReady(base::TimeTicks now,
+                          std::optional<base::TimeDelta> lead) {
+  OhosRenderStats& stats = GetOhosRenderStats();
+  base::AutoLock hold(stats.lock);
+  if (!stats.read_start.is_null()) {
+    const base::TimeDelta read = now - stats.read_start;
+    ++stats.reads;
+    stats.read_total += read;
+    stats.read_max = std::max(stats.read_max, read);
+    stats.read_start = base::TimeTicks();
+  }
+  stats.last_frame_ready = now;
+  if (!lead) {
+    return;
+  }
+  ++stats.arrived;
+  if (lead->is_negative()) {
+    ++stats.late;
+  } else if (*lead < base::Microseconds(16667)) {
+    ++stats.under_a_frame;
+  }
+  stats.least_lead = std::min(stats.least_lead, *lead);
+}
+
+void RecordOhosRender(base::TimeTicks now,
+                      base::TimeDelta gap,
+                      base::TimeDelta interval,
+                      size_t frames_dropped,
+                      size_t frames_queued) {
+  OhosRenderStats& stats = GetOhosRenderStats();
+  base::AutoLock hold(stats.lock);
+  if (stats.window_start.is_null()) {
+    stats.window_start = now;
+  }
+  ++stats.calls;
+  stats.dropped += frames_dropped;
+  stats.queued_min = std::min(stats.queued_min, frames_queued);
+  stats.queued_total += frames_queued;
+  stats.interval_min = std::min(stats.interval_min, interval);
+  stats.interval_max = std::max(stats.interval_max, interval);
+  stats.interval_total += interval;
+  // The first call after a pause has no gap worth counting.
+  if (gap < base::Seconds(1)) {
+    ++stats.gaps;
+    stats.gap_total += gap;
+    stats.longest_gap = std::max(stats.longest_gap, gap);
+    if (gap > base::Milliseconds(20)) {
+      ++stats.gaps_over_20ms;
+    }
+  }
+  const base::TimeDelta window = now - stats.window_start;
+  if (window < base::Seconds(5)) {
+    return;
+  }
+  auto avg_ms = [](base::TimeDelta total, int count) {
+    return count ? (total / count).InMillisecondsF() : 0.0;
+  };
+  LOG(WARNING) << "OHOS video render: " << stats.calls << " calls in "
+               << window.InSecondsF() << " s, longest gap "
+               << stats.longest_gap.InMillisecondsF() << " ms, "
+               << stats.gaps_over_20ms << " gaps over 20 ms, avg gap "
+               << avg_ms(stats.gap_total, stats.gaps)
+               << " ms, interval asked min "
+               << stats.interval_min.InMillisecondsF() << " avg "
+               << avg_ms(stats.interval_total, stats.calls) << " max "
+               << stats.interval_max.InMillisecondsF() << " ms, "
+               << stats.dropped << " frames dropped; queued min "
+               << stats.queued_min << " avg "
+               << static_cast<double>(stats.queued_total) / stats.calls
+               << "; " << stats.reads << " reads, avg "
+               << avg_ms(stats.read_total, stats.reads) << " ms, max "
+               << stats.read_max.InMillisecondsF()
+               << " ms; wait before next read avg "
+               << avg_ms(stats.wait_total, stats.waits) << " ms, max "
+               << stats.wait_max.InMillisecondsF() << " ms; "
+               << stats.arrived << " frames arrived, " << stats.late
+               << " late, " << stats.under_a_frame
+               << " with under a frame to spare, least lead "
+               << (stats.arrived ? stats.least_lead.InMillisecondsF() : 0.0)
+               << " ms";
+  const base::TimeTicks read_start = stats.read_start;
+  const base::TimeTicks last_frame_ready = stats.last_frame_ready;
+  stats.window_start = now;
+  stats.calls = 0;
+  stats.gaps_over_20ms = 0;
+  stats.dropped = 0;
+  stats.longest_gap = base::TimeDelta();
+  stats.queued_min = std::numeric_limits<size_t>::max();
+  stats.queued_total = 0;
+  stats.gap_total = base::TimeDelta();
+  stats.gaps = 0;
+  stats.interval_min = base::TimeDelta::Max();
+  stats.interval_max = base::TimeDelta();
+  stats.interval_total = base::TimeDelta();
+  stats.reads = 0;
+  stats.read_total = base::TimeDelta();
+  stats.read_max = base::TimeDelta();
+  stats.waits = 0;
+  stats.wait_total = base::TimeDelta();
+  stats.wait_max = base::TimeDelta();
+  stats.arrived = 0;
+  stats.late = 0;
+  stats.under_a_frame = 0;
+  stats.least_lead = base::TimeDelta::Max();
+  stats.read_start = read_start;
+  stats.last_frame_ready = last_frame_ready;
+}
