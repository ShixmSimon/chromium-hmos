+#elif BUILDFLAG(IS_OHOS)
+
+// HarmonyOS exposes DNS via NetConn, not /etc/resolv.conf. ScopedResState
+// already reads NetConn properties. Watch network changes and poll as a
+// fallback for DNS-only/VPN changes that do not change the interface address.
+class DnsConfigWatcher : public NetworkChangeNotifier::IPAddressObserver {
+ public:
+  using CallbackType = base::RepeatingCallback<void(bool succeeded)>;
+
+  ~DnsConfigWatcher() override {
+    if (watching_) {
+      NetworkChangeNotifier::RemoveIPAddressObserver(this);
+    }
+  }
+
+  bool Watch(const CallbackType& callback) {
+    callback_ = callback;
+    NetworkChangeNotifier::AddIPAddressObserver(this);
+    watching_ = true;
+    timer_.Start(FROM_HERE, base::Seconds(30),
+                 base::BindRepeating(&DnsConfigWatcher::Poll,
+                                     base::Unretained(this)));
+    return true;
+  }
+
+  void OnIPAddressChanged(
+      NetworkChangeNotifier::IPAddressChangeType) override {
+    Poll();
+  }
+
+ private:
+  void Poll() { callback_.Run(true); }
+
+  bool watching_ = false;
+  CallbackType callback_;
+  base::RepeatingTimer timer_;
+};
