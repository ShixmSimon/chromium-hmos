+#if BUILDFLAG(IS_OHOS)
+  // The same popup, anchored at a rectangle rather than at a View.
+  //
+  // The shell draws the toolbar, so there is no button to anchor to; it
+  // reports where it drew one instead. An anchor View would take priority
+  // over that rect (see BubbleDialogDelegate::GetAnchorRect), so this path
+  // sets no anchor view at all, and `parent` stands in for the anchor widget
+  // -- which is otherwise where the popup finds the window to watch.
+  //
+  // `anchor_rect_in_screen` is in screen coordinates. An empty-height rect
+  // along the bottom of the window makes the popup open upward from there,
+  // which is what a phone with no toolbar gets.
+  static void ShowPopupAtShellRect(
+      BrowserWindowInterface* browser,
+      std::unique_ptr<extensions::ExtensionViewHost> host,
+      views::Widget* parent,
+      const gfx::Rect& anchor_rect_in_screen,
+      views::BubbleBorder::Arrow arrow,
+      PopupShowAction show_action,
+      ShowPopupCallback callback);
+#endif  // BUILDFLAG(IS_OHOS)
