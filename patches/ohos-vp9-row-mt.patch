Thread VP9 software decoding by rows on OHOS.

A phone here decodes VP9 in software: it has no VP9 hardware decoder, and
unlike mobile Android this port builds libvpx with high bit depth, so
YouTube serves it 10-bit HDR up to 2160p60. libvpx threads across tile
columns only unless asked to thread by rows too (VP9D_SET_ROW_MT), which
spreads a frame over the decoder's threads however many columns it has.

Replaces ohos-vp9-row-threads.patch, which also logged decode times while
the HDR frame drops were being measured.

Generated against Chromium 154.0.8037.51.

Apply with:
  git -C /path/to/chromium/src apply /path/to/patches/ohos-vp9-row-mt.patch

diff --git a/media/filters/vpx_video_decoder.cc b/media/filters/vpx_video_decoder.cc
--- a/media/filters/vpx_video_decoder.cc
+++ b/media/filters/vpx_video_decoder.cc
@@ -20,6 +20,7 @@
 #include "base/numerics/byte_conversions.h"
 #include "base/task/bind_post_task.h"
 #include "base/trace_event/trace_event.h"
+#include "build/build_config.h"
 #include "media/base/agtm.h"
 #include "media/base/decoder_buffer.h"
 #include "media/base/limits.h"
@@ -243,6 +244,14 @@ bool VpxVideoDecoder::ConfigureDecoder(const VideoDecoderConfig& config) {
                   << vpx_codec_error(vpx_codec_.get());
       return false;
     }
+
+#if BUILDFLAG(IS_OHOS)
+    // libvpx threads across tile columns only, unless asked to thread by
+    // rows too. Row threading spreads a frame over the decoder's threads
+    // however many columns it has; 2160p60 VP9 needs every thread it can
+    // get on a phone without a VP9 decoder. Not having it is not an error.
+    vpx_codec_control(vpx_codec_.get(), VP9D_SET_ROW_MT, 1);
+#endif
   }
 
   if (config.alpha_mode() == VideoDecoderConfig::AlphaMode::kIsOpaque)
