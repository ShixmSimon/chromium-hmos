+void SubtleNotificationView::InstructionView::SetCompactText(
+    const std::u16string& origin,
+    const std::u16string& instruction,
+    int max_width) {
+  RemoveAllChildViews();
+  compact_ = true;
+  SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical, gfx::Insets(), 2));
+  if (!origin.empty()) {
+    auto* label = AddChildView(std::make_unique<views::Label>(
+        origin, views::style::CONTEXT_LABEL));
+    label->SetEnabledColor(SK_ColorWHITE);
+    label->SetBackgroundColor(GetSubtleNotificationBackgroundColor());
+    label->SetElideBehavior(gfx::ELIDE_HEAD);
+    label->SetMaximumWidthSingleLine(max_width);
+  }
+  auto* label = AddChildView(std::make_unique<views::Label>(
+      instruction, views::style::CONTEXT_LABEL));
+  label->SetEnabledColor(SK_ColorWHITE);
+  label->SetBackgroundColor(GetSubtleNotificationBackgroundColor());
+  label->SetMultiLine(true);
+  label->SetMaximumWidth(max_width);
+  text_ = origin.empty() ? instruction : origin + u"\n" + instruction;
+  OnPropertyChanged(&text_, views::PropertyEffects::kPaint);
+}
