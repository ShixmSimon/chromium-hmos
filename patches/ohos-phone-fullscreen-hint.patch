+
+void SubtleNotificationView::UpdateCompactContent(
+    const std::u16string& origin,
+    const std::u16string& instruction,
+    int max_width) {
+  constexpr int kCompactPadding = 12;
+  SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kHorizontal,
+      gfx::Insets::VH(8, kCompactPadding)));
+  instruction_view_->SetCompactText(
+      origin, instruction,
+      std::max(1, max_width - 2 * kCompactPadding - GetInsets().width()));
+  instruction_view_->SetVisible(true);
   DeprecatedLayoutImmediately();
 }
 
