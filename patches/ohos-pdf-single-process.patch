+
+#if BUILDFLAG(IS_OHOS)
+// Whether the whole browser is one process.
+//
+// HarmonyOS phones run that way: the shell has no native child processes to
+// spawn there, so OhosChromeMainRunner passes --single-process. Tablets and
+// 2in1s do spawn them and are ordinary multi-process Chromium.
+bool RunsEverythingInOneProcess() {
+  static const bool one_process =
+      base::CommandLine::ForCurrentProcess()->HasSwitch(
