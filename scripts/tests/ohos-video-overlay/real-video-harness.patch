diff --git a/products/shell/src/main/ets/entryability/EntryAbility.ets b/products/shell/src/main/ets/entryability/EntryAbility.ets
index 594da12..f38fab2 100644
--- a/products/shell/src/main/ets/entryability/EntryAbility.ets
+++ b/products/shell/src/main/ets/entryability/EntryAbility.ets
@@ -160,7 +160,26 @@ export default class EntryAbility extends UIAbility {
   }
 
   /** Explicit debug-only probe; onNewWant repeats it without replacing the PID. */
+  private realVideoTimer: number = -1;
   private runJitProbe(want: Want): boolean {
+    const fixture = want.parameters?.['lumieRealVideo'];
+    if (BuildProfile.DEBUG && typeof fixture === 'string' && this.realVideoTimer === -1) {
+      window.getLastWindow(this.context).then((w: window.Window): void => { w.setWindowKeepScreenOn(true); });
+      metadataPrewarm.startRealVideo(fixture);
+      this.realVideoTimer = setInterval((): void => {
+        if (metadataPrewarm.pumpRealVideo() === 1) {
+          clearInterval(this.realVideoTimer);
+          this.realVideoTimer = -1;
+          window.getLastWindow(this.context).then((w: window.Window): void => { w.setWindowKeepScreenOn(false); });
+        }
+      }, 33);
+      return true;
+    }
+    if (BuildProfile.DEBUG && want.parameters?.['lumieRealVideoStop'] === true) {
+      metadataPrewarm.stopRealVideo();
+      return true;
+    }
+
     if (!BuildProfile.DEBUG || want.parameters?.['lumieJitProbe'] !== true) {
       return false;
     }
