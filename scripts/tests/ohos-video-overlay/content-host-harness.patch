@@ -0,0 +1,44 @@
+import { NodeContent } from '@kit.ArkUI';
+import metadataPrewarm from 'liblumie_prewarm.so';
+
+@Entry({ routeName: 'OverlayContentProbe' })
+@ComponentV2
+export struct OverlayContentProbe {
+  private content: NodeContent = new NodeContent();
+  private timer: number = -1;
+  @Local stage: number = 0;
+
+  aboutToDisappear(): void {
+    this.stop();
+  }
+
+  private start(): void {
+    this.stage = metadataPrewarm.startOverlayHost(this.content);
+    if (this.stage > 0 && this.timer < 0) {
+      this.timer = setInterval((): void => {
+        this.stage = metadataPrewarm.pollOverlayHost();
+      }, 100);
+    }
+  }
+
+  private stop(): void {
+    if (this.timer >= 0) { clearInterval(this.timer); this.timer = -1; }
+    this.stage = metadataPrewarm.stopOverlayHost();
+  }
+
+  build() {
+    Column({ space: 16 }) {
+      Text('Overlay ContentSlot test').fontSize(22)
+      Text(`stage=${this.stage}`).id('overlay-stage')
+      Row({ space: 16 }) {
+        Button('Start').id('overlay-start').onClick((): void => { this.start(); })
+        Button('Stop').id('overlay-stop').onClick((): void => { this.stop(); })
+      }
+      Stack({ alignContent: Alignment.TopStart }) {
+        Text('Owned webpage viewport').fontSize(14)
+        ContentSlot(this.content)
+      }.width('100%').height(240).backgroundColor('#333333').clip(true).hitTestBehavior(HitTestMode.None)
+      Text('Cyan fixture must stay inside the viewport; Stop removes it.')
+    }.width('100%').height('100%').padding({ top: 64, left: 20, right: 20 }).backgroundColor('#EEEEEE')
+  }
+}
